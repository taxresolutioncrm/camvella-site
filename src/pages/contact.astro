---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Contact Camvella"
  description="Get in touch with the Camvella team. Sales questions, support, or general inquiries."
>
  <div style="padding-top: 64px; min-height: 80vh; background: var(--clr-surface);">
    <div class="container" style="padding-top: var(--space-16); padding-bottom: var(--space-16); max-width: 600px;">
      <h1 style="font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 800; color: var(--clr-navy); margin-bottom: var(--space-4);">Get in touch.</h1>
      <p style="font-size: var(--text-lg); color: var(--clr-text-soft); margin-bottom: var(--space-10); line-height: 1.65;">Sales questions, support, partnerships, or anything else — we respond within one business day.</p>

      <form
        id="contact-form"
        novalidate
        aria-label="Contact form"
        style="background: white; padding: var(--space-8); border-radius: var(--radius-xl); border: 1px solid var(--clr-border); box-shadow: var(--shadow-sm);"
      >
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="c_first">First name <span aria-hidden="true">*</span></label>
            <input class="form-input" type="text" id="c_first" name="first_name" required autocomplete="given-name" />
          </div>
          <div class="form-group">
            <label class="form-label" for="c_last">Last name <span aria-hidden="true">*</span></label>
            <input class="form-input" type="text" id="c_last" name="last_name" required autocomplete="family-name" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="c_email">Email <span aria-hidden="true">*</span></label>
          <input class="form-input" type="email" id="c_email" name="email" required inputmode="email" autocomplete="email" />
        </div>
        <div class="form-group">
          <label class="form-label" for="c_subject">Subject <span aria-hidden="true">*</span></label>
          <select class="form-select" id="c_subject" name="subject" required>
            <option value="">Select one</option>
            <option value="sales">Sales / Demo request</option>
            <option value="support">Product support</option>
            <option value="partnership">Partnership inquiry</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="c_message">Message <span aria-hidden="true">*</span></label>
          <textarea class="form-textarea" id="c_message" name="message" required rows="5"></textarea>
        </div>
        <button type="submit" class="btn btn--primary" style="width: 100%;" data-event="contact_form_submit">Send Message</button>
        <p class="contact-form-error" hidden style="font-size: var(--text-sm); color: var(--clr-error, #dc2626); margin-top: var(--space-2); text-align: center;"></p>
      </form>

      <div style="margin-top: var(--space-8); text-align: center;">
        <p style="font-size: var(--text-sm); color: var(--clr-text-soft);">Looking to request a demo? <a href="/demo" style="color: var(--clr-navy); font-weight: 600;">Use the demo form →</a></p>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const EDGE = 'https://fjqywulzsyfyzitneazb.supabase.co/functions/v1/submit-demo-lead';
      const form = document.getElementById('contact-form');
      if (!form) return;

      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = form.querySelector('[type="submit"]');
        const errEl = form.querySelector('.contact-form-error');
        const fields = Object.fromEntries(new FormData(form).entries());
        const required = ['first_name', 'last_name', 'email', 'subject', 'message'];
        const missing = required.filter((key) => !String(fields[key] || '').trim());

        if (missing.length) {
          if (errEl) {
            errEl.textContent = 'Please fill in all required fields.';
            errEl.hidden = false;
          }
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Sending…';
        if (errEl) errEl.hidden = true;

        try {
          const res = await fetch(EDGE, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              first_name: String(fields.first_name).trim(),
              last_name: String(fields.last_name).trim(),
              email: String(fields.email).trim(),
              company: 'Website contact',
              communities: 'contact',
              subject: String(fields.subject).trim(),
              message: String(fields.message).trim(),
              form_type: 'contact',
              source_page: '/contact'
            })
          });

          const data = await res.json().catch(() => ({}));
          if (!res.ok || !data.success) throw new Error(data.error || 'Unable to send your message.');

          form.innerHTML = '<p style="text-align:center;padding:2rem 0;font-weight:600">Thanks! Your message was sent. We will be in touch shortly.</p>';
        } catch (err) {
          btn.disabled = false;
          btn.textContent = 'Send Message';
          if (errEl) {
            errEl.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
            errEl.hidden = false;
          }
        }
      });
    })();
  </script>
</BaseLayout>
