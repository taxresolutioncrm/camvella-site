---
import BaseLayout from '../../layouts/BaseLayout.astro'

const resources = [
  { href: "/features/hoa-accounting", title: "HOA Accounting", excerpt: "Assessment billing, accounts payable, general ledger, budgeting, financial statements, and board-ready reporting in one HOA-specific workflow.", category: "Financial Management" },
  { href: "/features/violations", title: "Violation Management", excerpt: "Track the complete violation lifecycle from inspection and notices through fines, hearings, reinspections, and resolution.", category: "Operations" },
  { href: "/features/arc", title: "Architectural Review", excerpt: "Centralize ARC submissions, supporting documents, committee review, board voting, decisions, and resident communication.", category: "Operations" },
  { href: "/features/work-orders", title: "Work Orders & Maintenance", excerpt: "Manage service requests, work orders, vendor assignment, attachments, status changes, and completion history.", category: "Operations" },
  { href: "/features/board-portal", title: "Board Operations", excerpt: "Meetings, agendas, resolutions, minutes, documents, voting, and secure financial visibility for board members.", category: "Governance" },
  { href: "/features/resident-portal", title: "Resident Self-Service", excerpt: "Give residents mobile access to violations, ARC, service requests, statements, documents, and profile updates.", category: "Resident Experience" },
  { href: "/features/communications", title: "HOA Communications", excerpt: "Coordinate email, SMS, templates, targeted audiences, delivery history, and office communication records.", category: "Communications" },
  { href: "/compare/camvella-vs-cinc", title: "Camvella vs. CINC Systems", excerpt: "Compare product focus, implementation approach, core HOA workflows, financial operations, and the management-company experience.", category: "Software Evaluation" },
  { href: "/compare/camvella-vs-vantaca", title: "Camvella vs. Vantaca", excerpt: "A workflow-first evaluation across accounting, portfolio operations, boards, residents, communications, security, and implementation.", category: "Software Evaluation" },
  { href: "/compare/camvella-vs-appfolio", title: "Camvella vs. AppFolio", excerpt: "Compare the operational and financial workflows professional community management teams run every day.", category: "Software Evaluation" },
  { href: "/compare", title: "HOA Software Comparison Center", excerpt: "Use a structured eight-part evaluation across accounting, operations, boards, residents, communications, security, implementation, and total cost.", category: "Buyer Guide" },
  { href: "/solutions/hoa-management-software", title: "HOA Management Software Guide", excerpt: "See how professional CAM companies can connect accounting, compliance, boards, residents, work orders, vendors, documents, and communications.", category: "Buyer Guide" },
  { href: "/solutions/community-association-management-software", title: "Community Association Management Software", excerpt: "A connected software model for management companies running multiple associations and keeping financial and operational records aligned.", category: "Buyer Guide" },
  { href: "/solutions/florida-hoa-management-software", title: "HOA Management Software for Florida", excerpt: "A Florida-focused guide for professional community association management teams evaluating connected HOA operations software.", category: "Regional Guide" },
  { href: "/solutions/texas-hoa-management-software", title: "HOA Management Software for Texas", excerpt: "A Texas-focused guide for management companies evaluating accounting, compliance, resident, board, work-order, and vendor workflows.", category: "Regional Guide" },
  { href: "/solutions/hoa-software-small-management-companies", title: "HOA Software for Small Management Companies", excerpt: "A practical guide for small and growing management companies that need professional accounting and operations without enterprise sprawl.", category: "Buyer Guide" },
]
---

<BaseLayout
  title="HOA Management Resources & Buyer Guides | Camvella"
  description="Explore Camvella guides for HOA accounting, violations, ARC, boards, residents, communications, work orders, and community management software evaluation."
>
  <section class="resource-hero">
    <div class="container resource-hero__grid">
      <div>
        <p class="resource-eyebrow">Camvella resource center</p>
        <h1>Practical guides for running — and choosing — HOA management software.</h1>
        <p>Product guides for the workflows your team runs every day, plus buyer resources for evaluating platforms before you move a portfolio.</p>
      </div>
      <div class="resource-hero__stats">
        <div><strong>7</strong><span>workflow guides</span></div>
        <div><strong>4+</strong><span>buyer guides</span></div>
        <div><strong>1</strong><span>connected platform</span></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="resource-headline">
    <div class="container">
      <p class="section__label">Browse the library</p>
      <h2 class="section__headline" id="resource-headline">Start with the problem you are solving.</h2>
      <p class="section__subhead">Use the product guides to understand a workflow in depth, then use the comparison center when you are evaluating a switch.</p>
      <div class="resource-grid">
        {resources.map((resource, i) => (
          <article class:list={['resource-card', { 'resource-card--featured': i === 0 }]}>
            <div class="resource-card__meta"><span>{resource.category}</span><span>{String(i + 1).padStart(2,'0')}</span></div>
            <h3><a href={resource.href}>{resource.title}</a></h3>
            <p>{resource.excerpt}</p>
            <a href={resource.href} class="resource-card__link">Explore guide →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container resource-paths">
      <div>
        <p class="section__label">For operators</p>
        <h2 class="section__headline">See how the pieces connect.</h2>
        <p class="section__subhead">Accounting, ARC, violations, work orders, boards, residents, vendors, documents, and communications should share the same community context instead of becoming separate islands of data.</p>
        <a href="/product" class="btn btn--dark" style="margin-top:var(--space-6)">Explore the full product</a>
      </div>
      <div>
        <p class="section__label">For buyers</p>
        <h2 class="section__headline">Make your evaluation harder — on purpose.</h2>
        <p class="section__subhead">Bring real workflows, real permission requirements, a real accounting month, and a real community to every vendor demo. That is how you find out what will actually work.</p>
        <a href="/compare" class="btn btn--dark" style="margin-top:var(--space-6)">Open comparison center</a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container resource-cta">
      <div>
        <p class="section__label">See Camvella live</p>
        <h2 class="section__headline">Use one of your communities in the demo.</h2>
        <p class="section__subhead">Walk through accounting, violations, ARC, board operations, resident workflows, documents, and communications against the way your team actually works.</p>
      </div>
      <a href="/demo" class="btn btn--primary btn--lg">Book a Demo</a>
    </div>
  </section>
</BaseLayout>

<style>
.resource-hero{padding:calc(64px + var(--space-16)) 0 var(--space-16);background:linear-gradient(135deg,var(--clr-navy),#0d3857);color:#fff}
.resource-hero__grid{display:grid;grid-template-columns:1.15fr .85fr;gap:var(--space-16);align-items:center}
.resource-eyebrow{font-size:var(--text-xs);font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#7ed6df;margin-bottom:var(--space-4)}
.resource-hero h1{font-size:clamp(2.25rem,4.6vw,3.75rem);line-height:1.04;letter-spacing:-.04em;max-width:18ch;margin-bottom:var(--space-5)}
.resource-hero p{font-size:var(--text-lg);line-height:1.7;color:rgba(255,255,255,.75);max-width:58ch}
.resource-hero__stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.resource-hero__stats div{padding:var(--space-5);border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);border-radius:var(--radius-lg)}
.resource-hero__stats strong,.resource-hero__stats span{display:block}.resource-hero__stats strong{font-size:var(--text-2xl)}.resource-hero__stats span{font-size:var(--text-xs);color:rgba(255,255,255,.62);margin-top:4px}
.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-5);margin-top:var(--space-10)}
.resource-card{display:flex;flex-direction:column;min-height:250px;padding:var(--space-6);background:#fff;border:1px solid var(--clr-border);border-radius:var(--radius-xl);transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}
.resource-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);border-color:var(--clr-teal)}
.resource-card--featured{grid-column:span 2;background:linear-gradient(135deg,#f7fbfc,#fff);border-color:rgba(11,143,156,.4)}
.resource-card__meta{display:flex;justify-content:space-between;gap:12px;font-size:var(--text-xs);font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--clr-teal);margin-bottom:var(--space-6)}
.resource-card h3{font-size:var(--text-xl);color:var(--clr-navy);margin-bottom:var(--space-3)}
.resource-card p{font-size:var(--text-sm);line-height:1.65;color:var(--clr-text-soft);margin-bottom:var(--space-5)}
.resource-card__link{margin-top:auto;font-size:var(--text-sm);font-weight:700;color:var(--clr-navy)}
.resource-paths{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-16)}
.resource-cta{display:flex;align-items:center;justify-content:space-between;gap:var(--space-10)}
.resource-cta .section__headline{color:#fff}
@media(max-width:900px){.resource-hero__grid,.resource-paths{grid-template-columns:1fr}.resource-grid{grid-template-columns:repeat(2,1fr)}.resource-card--featured{grid-column:span 2}.resource-cta{align-items:flex-start;flex-direction:column}}
@media(max-width:640px){.resource-grid,.resource-hero__stats{grid-template-columns:1fr}.resource-card--featured{grid-column:auto}}
</style>

<style>
/* Final visual density pass */
.resource-hero{padding:112px 0 58px!important}
.resource-hero__grid{gap:48px!important}
.resource-hero h1{font-size:clamp(2.45rem,4.2vw,3.8rem)!important;max-width:17ch!important}
.resource-hero__stats{gap:10px!important}
.resource-hero__stats div{padding:18px!important}
.resource-hero + .section{padding-top:48px!important;padding-bottom:56px!important}
.resource-grid{gap:16px!important;margin-top:28px!important}
.resource-card{min-height:220px!important;padding:22px!important;border-radius:15px!important;box-shadow:0 8px 24px rgba(11,39,72,.06)}
.resource-card--featured{grid-column:span 2!important;min-height:220px!important;background:linear-gradient(135deg,#0d2c4b,#0f5664)!important;border-color:transparent!important}
.resource-card--featured h3,.resource-card--featured h3 a,.resource-card--featured .resource-card__link{color:#fff!important}
.resource-card--featured p{color:rgba(255,255,255,.72)!important}
.resource-card--featured .resource-card__meta{color:#8cdee5!important}
.resource-paths{gap:28px!important}
.resource-paths>div{padding:28px;border:1px solid #dbe6ed;border-radius:16px;background:#fff;box-shadow:0 8px 24px rgba(11,39,72,.05)}
.resource-cta{padding-top:2px;padding-bottom:2px}
.section--alt{padding-top:64px!important;padding-bottom:64px!important}
@media(max-width:640px){.resource-hero{padding:96px 0 46px!important}.resource-hero + .section{padding-top:38px!important}.resource-card--featured{grid-column:auto!important}}
</style>
