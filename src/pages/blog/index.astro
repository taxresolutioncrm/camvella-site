---
import BaseLayout from '../../layouts/BaseLayout.astro'

const resources = [
  {
    href: "/features/hoa-accounting",
    title: "HOA Accounting",
    excerpt: "Assessment billing, accounts payable, general ledger, budgeting, financial statements, and board-ready reporting in one HOA-specific workflow.",
    category: "Financial Management",
  },
  {
    href: "/features/violations",
    title: "Violation Management",
    excerpt: "Track the complete violation lifecycle—from inspection and notices through fines, hearings, reinspections, and resolution.",
    category: "Operations",
  },
  {
    href: "/features/arc",
    title: "Architectural Review",
    excerpt: "Centralize ARC submissions, supporting documents, committee review, board voting, decisions, and resident communication.",
    category: "Operations",
  },
  {
    href: "/compare/camvella-vs-cinc",
    title: "Camvella vs. CINC Systems",
    excerpt: "Compare product focus, implementation approach, core HOA workflows, financial operations, and the management-company experience.",
    category: "Software Evaluation",
  },
]
---

<BaseLayout
  title="HOA Management Resources | Camvella"
  description="Explore Camvella guides for HOA accounting, violation management, architectural review, and community management software evaluation."
>
  <div style="padding-top: calc(64px + var(--space-16)); padding-bottom: var(--space-8); background: var(--clr-navy); color: white;">
    <div class="container">
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; max-width: 22ch; margin-bottom: var(--space-4); line-height: 1.1;">Resources for professional HOA management.</h1>
      <p style="font-size: var(--text-lg); color: rgba(255 255 255 / 0.75); max-width: 52ch; line-height: 1.65;">Practical product guides for HOA accounting, violations, ARC workflows, and evaluating the right management platform for your portfolio.</p>
    </div>
  </div>

  <section class="section" aria-labelledby="resource-headline">
    <div class="container">
      <h2 class="visually-hidden" id="resource-headline">Camvella resources</h2>
      <div style="display: flex; flex-direction: column; gap: var(--space-6);">
        {resources.map(resource => (
          <article style="padding: var(--space-6); background: var(--clr-white); border: 1px solid var(--clr-border); border-radius: var(--radius-lg);">
            <p style="font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--clr-amber-dark); margin-bottom: var(--space-2);">{resource.category}</p>
            <h2 style="font-size: var(--text-xl); font-weight: 800; color: var(--clr-navy); margin-bottom: var(--space-3); line-height: 1.3;">
              <a href={resource.href} style="color: inherit;">{resource.title}</a>
            </h2>
            <p style="font-size: var(--text-sm); color: var(--clr-text-soft); line-height: 1.65; margin-bottom: var(--space-4); max-width: 68ch;">{resource.excerpt}</p>
            <a href={resource.href} style="font-size: var(--text-sm); font-weight: 600; color: var(--clr-navy);">Explore guide →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container" style="text-align: center;">
      <h2 style="font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; color: white; margin-bottom: var(--space-4);">See Camvella in action.</h2>
      <p style="color: rgba(255 255 255 / 0.7); margin-bottom: var(--space-8); max-width: 48ch; margin-left: auto; margin-right: auto;">See how Camvella fits your communities, team structure, financial workflows, and resident operations.</p>
      <a href="/demo" class="btn btn--primary btn--lg" data-event="demo_cta_click">Book a Demo</a>
    </div>
  </section>
</BaseLayout>
