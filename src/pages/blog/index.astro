---
import BaseLayout from '../../layouts/BaseLayout.astro'

// Blog posts will be loaded from content collection once Contentlayer/MDX is wired.
// Placeholder posts for Phase 1 — replace with real content.
const posts = [
  {
    slug: "hoa-accounting-guide",
    title: "The Complete Guide to HOA Accounting",
    excerpt: "HOA accounting is not the same as general accounting. Fund accounting, assessment billing, reserve tracking — here's what every management company needs to know.",
    date: "August 2026",
    category: "Financial Management",
  },
  {
    slug: "hoa-violation-management",
    title: "HOA Violation Management: The Professional Manager's Complete Guide",
    excerpt: "Violations are the most time-consuming — and confrontation-heavy — part of HOA management. Here's how to handle them systematically, from first notice to resolution.",
    date: "August 2026",
    category: "Operations",
  },
  {
    slug: "hoa-arc-process",
    title: "HOA Architectural Review: How the ARC Process Should Actually Work",
    excerpt: "ARC is where most HOA management software falls short. Here's the complete workflow for managing architectural requests at scale — without the spreadsheets.",
    date: "August 2026",
    category: "Operations",
  },
  {
    slug: "evaluate-hoa-software",
    title: "How to Evaluate HOA Management Software in 2026",
    excerpt: "Most HOA software evaluation guides lead with feature checklists. That's backwards. Here's the framework that actually helps you choose a platform you won't outgrow.",
    date: "August 2026",
    category: "Software Evaluation",
  },
]
---

<BaseLayout
  title="HOA Management Resources & Blog | Camvella"
  description="HOA accounting guides, violation management best practices, ARC workflows, and software evaluation resources for professional community association management companies."
>
  <div style="padding-top: calc(64px + var(--space-16)); padding-bottom: var(--space-8); background: var(--clr-navy); color: white;">
    <div class="container">
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; max-width: 22ch; margin-bottom: var(--space-4); line-height: 1.1;">Resources for professional HOA management.</h1>
      <p style="font-size: var(--text-lg); color: rgba(255 255 255 / 0.75); max-width: 52ch; line-height: 1.65;">Guides on HOA accounting, violations, ARC, board operations, and software evaluation — written for professional management companies, not volunteer boards.</p>
    </div>
  </div>

  <section class="section" aria-labelledby="blog-headline">
    <div class="container">
      <h2 class="visually-hidden" id="blog-headline">Articles and guides</h2>
      <div style="display: flex; flex-direction: column; gap: var(--space-6);">
        {posts.map(post => (
          <article style="padding: var(--space-6); background: var(--clr-white); border: 1px solid var(--clr-border); border-radius: var(--radius-lg); display: grid; grid-template-columns: 1fr auto; gap: var(--space-6); align-items: start;">
            <div>
              <p style="font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--clr-amber-dark); margin-bottom: var(--space-2);">{post.category}</p>
              <h3 style="font-size: var(--text-xl); font-weight: 800; color: var(--clr-navy); margin-bottom: var(--space-3); line-height: 1.3;">
                <a href={`/blog/${post.slug}`} style="color: inherit;">{post.title}</a>
              </h3>
              <p style="font-size: var(--text-sm); color: var(--clr-text-soft); line-height: 1.65; margin-bottom: var(--space-4); max-width: 68ch;">{post.excerpt}</p>
              <a href={`/blog/${post.slug}`} style="font-size: var(--text-sm); font-weight: 600; color: var(--clr-navy);">Read guide →</a>
            </div>
            <p style="font-size: var(--text-xs); color: var(--clr-text-soft); white-space: nowrap; padding-top: 2px;">{post.date}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container" style="text-align: center;">
      <h2 style="font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; color: white; margin-bottom: var(--space-4);">See Camvella in action.</h2>
      <p style="color: rgba(255 255 255 / 0.7); margin-bottom: var(--space-8); max-width: 48ch; margin-left: auto; margin-right: auto;">Reading about HOA management is useful. Seeing the software against your actual communities is better.</p>
      <a href="/demo" class="btn btn--primary btn--lg" data-event="demo_cta_click">Book a Demo</a>
    </div>
  </section>
</BaseLayout>
