---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { seoGuides } from '../../data/seoGuides'

export function getStaticPaths(){
  return seoGuides.map((guide)=>({params:{slug:guide.slug},props:{guide}}))
}
const { guide } = Astro.props
const canonical=`https://camvella.com/guides/${guide.slug}/`
const schema=[
 {'@context':'https://schema.org','@type':'Article','headline':guide.title,'description':guide.description,'mainEntityOfPage':canonical,'author':{'@type':'Organization','name':'Camvella','url':'https://camvella.com/'},'publisher':{'@type':'Organization','name':'Camvella','url':'https://camvella.com/'},'datePublished':'2026-09-16','dateModified':'2026-09-16','inLanguage':'en-US'},
 {'@context':'https://schema.org','@type':'FAQPage','mainEntity':guide.faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))}
]
---
<BaseLayout title={`${guide.title} | Camvella`} description={guide.description} schema={schema}>
<section class="guide-hero"><div class="container container--narrow"><p class="section__label">{guide.eyebrow}</p><h1>{guide.h1}</h1><p>{guide.intro}</p></div></section>
<section class="section"><div class="container container--narrow guide-body">
<div class="quick"><strong>Quick answer:</strong> {guide.intro}</div>
{guide.sections.map(([heading,body]) => <><h2>{heading}</h2><p>{body}</p></>)}
<div class="guide-cta"><h2>See how Camvella connects the workflow.</h2><p>Bring one community and the operating process your team cares about. We will show how the platform keeps association work connected.</p><a class="btn btn--primary btn--lg" href="/demo">Book a Portfolio Demo</a><a class="btn btn--ghost btn--lg" href="/guides">Browse Guides</a></div>
<section class="faq-block"><h2>Frequently asked questions</h2>{guide.faq.map(([q,a]) => <article><h3>{q}</h3><p>{a}</p></article>)}</section>
</div></section>
</BaseLayout>
<style>.guide-hero{padding:clamp(7rem,12vw,10rem) 0 4rem}.guide-hero h1{max-width:920px}.guide-hero p{max-width:780px;font-size:1.08rem;line-height:1.8}.guide-body{max-width:820px}.guide-body h2{margin-top:2.7rem;font-size:clamp(1.5rem,2.7vw,2.15rem)}.guide-body p{font-size:1.02rem;line-height:1.8}.quick{padding:1.2rem 1.4rem;border-left:3px solid var(--green);background:#f7fbf8;line-height:1.7;margin-bottom:2rem}.guide-cta{margin-top:3rem;padding:2rem;border:1px solid var(--line);border-radius:16px}.faq-block{margin-top:2.5rem}.faq-block article{padding:1.1rem 0;border-top:1px solid var(--line)}.faq-block h3{margin:0 0 .5rem}</style>
