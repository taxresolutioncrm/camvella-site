---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { seoGuides } from '../../data/seoGuides'

export function getStaticPaths(){
  return seoGuides.map((guide)=>({params:{slug:guide.slug},props:{guide}}))
}
const { guide } = Astro.props
const relatedFeature = guide.slug.includes('work-order') ? { href:'/features/work-orders',label:'Work order management' }
  : guide.slug.includes('vendor') ? {href:'/features/vendors',label:'Vendor management'}
  : guide.slug.includes('board') ? {href:'/features/board-portal',label:'Board operations'}
  : guide.slug.includes('resident') || guide.slug.includes('communication') ? {href:'/features/communications',label:'Resident communications'}
  : guide.slug.includes('architectural') || guide.slug.includes('arc') ? {href:'/features/arc',label:'Architectural reviews'}
  : guide.slug.includes('violation') ? {href:'/features/violations',label:'Violation management'}
  : guide.slug.includes('account') || guide.slug.includes('budget') || guide.slug.includes('reserve') ? {href:'/features/hoa-accounting',label:'HOA accounting'}
  : {href:'/product',label:'Explore the Camvella platform'}
const relatedGuide = guide.slug === 'best-hoa-management-software'
  ? {href:'/guides/hoa-software-buyers-guide/',label:'HOA software buyer’s guide'}
  : {href:'/guides/best-hoa-management-software/',label:'How to compare HOA management software'}

const canonical=`https://camvella.com/guides/${guide.slug}/`
const schema=[
 {'@context':'https://schema.org','@type':'Article','headline':guide.title,'description':guide.description,'mainEntityOfPage':canonical,'author':{'@type':'Organization','name':'Camvella','url':'https://camvella.com/'},'publisher':{'@type':'Organization','name':'Camvella','url':'https://camvella.com/'},'datePublished':'2026-09-16','dateModified':'2026-09-16','inLanguage':'en-US'},
 {'@context':'https://schema.org','@type':'FAQPage','mainEntity':guide.faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))}
]
---
<BaseLayout title={`${guide.title} | Camvella`} description={guide.description} schema={schema}>
<section class="guide-hero"><div class="container container--narrow"><p class="section__label">{guide.eyebrow}</p><h1>{guide.h1}</h1><p>{guide.intro}</p></div></section>
<section class="section"><div class="container container--narrow guide-body">
<div class="quick"><strong>Quick answer:</strong> {guide.intro}</div>
{guide.sections.map(([heading,body]) => <><h2>{heading}</h2><p>{body}</p></>)}
<nav class="guide-related" aria-label="Related HOA management resources"><h2>Continue exploring this workflow</h2><div class="guide-related__links"><a href={relatedFeature.href}><span>Explore feature</span><strong>{relatedFeature.label}</strong></a><a href={relatedGuide.href}><span>Related guide</span><strong>{relatedGuide.label}</strong></a></div></nav>
<div class="guide-cta"><h2>See how Camvella connects the workflow.</h2><p>Bring one community and the operating process your team cares about. We will show how the platform keeps association work connected.</p><a class="btn btn--primary btn--lg" href="/demo">Book a Portfolio Demo</a><a class="btn btn--ghost btn--lg" href="/guides">Browse Guides</a></div>
<section class="faq-block"><h2>Frequently asked questions</h2>{guide.faq.map(([q,a]) => <article><h3>{q}</h3><p>{a}</p></article>)}</section>
</div></section>
</BaseLayout>
<style>.guide-hero{padding:clamp(7rem,12vw,10rem) 0 4rem}.guide-hero h1{max-width:920px}.guide-hero p{max-width:780px;font-size:1.08rem;line-height:1.8}.guide-body{max-width:820px}.guide-body h2{margin-top:2.7rem;font-size:clamp(1.5rem,2.7vw,2.15rem)}.guide-body p{font-size:1.02rem;line-height:1.8}.quick{padding:1.2rem 1.4rem;border-left:3px solid var(--clr-amber);background:#f7fbf8;line-height:1.7;margin-bottom:2rem}.guide-cta{margin-top:3rem;padding:2rem;border:1px solid var(--line);border-radius:16px}.faq-block{margin-top:2.5rem}.faq-block article{padding:1.1rem 0;border-top:1px solid var(--line)}.faq-block h3{margin:0 0 .5rem}.guide-related{margin:3rem 0 1rem}.guide-related h2{margin:0 0 1.2rem}.guide-related__links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.guide-related__links a{display:grid;gap:6px;padding:20px;border:1px solid var(--clr-border);border-radius:14px;background:#fff;transition:border-color .2s ease,box-shadow .2s ease}.guide-related__links a:hover,.guide-related__links a:focus-visible{border-color:var(--clr-teal);box-shadow:0 9px 24px rgba(11,143,156,.11)}.guide-related__links a span{font-size:.76rem;color:var(--clr-teal);font-weight:700}.guide-related__links a strong{color:var(--clr-navy)}@media(max-width:600px){.guide-related__links{grid-template-columns:1fr}}
</style>
