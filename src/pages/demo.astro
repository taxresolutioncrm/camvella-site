---
import BaseLayout from '../layouts/BaseLayout.astro'

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Schedule a Camvella Demo",
  "url": "https://camvella.com/demo",
  "description": "Book a live Camvella demo using real-time availability."
}
---

<BaseLayout
  title="Schedule a Camvella Demo"
  description="Choose a real available date and time for a personalized Camvella walkthrough."
  schema={schema}
>
  <main class="demo-page">
    <section class="demo-hero container">
      <div class="demo-copy">
        <span class="demo-eyebrow">LIVE PRODUCT DEMO</span>
        <h1>See Camvella in action.</h1>
        <p>Pick a real available time for a 30-minute walkthrough tailored to your communities, team structure, financial workflows, and resident operations.</p>
        <div class="demo-points">
          <div><strong>Real availability</strong><span>Only open appointment times are shown.</span></div>
          <div><strong>No double booking</strong><span>The booking engine rechecks the selected slot before confirming.</span></div>
          <div><strong>Instant confirmation</strong><span>Your appointment is created through the central RomyLabs scheduling engine and confirmation is sent automatically.</span></div>
        </div>
      </div>

      <div class="scheduler-shell" aria-label="Camvella demo scheduler">
        <iframe
          id="camvella-scheduler"
          title="Schedule a Camvella Demo"
          src="https://taxrescrm.app/book?product=camvella"
          loading="eager"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .demo-page {
    min-height: 100vh;
    padding-top: calc(64px + var(--space-12));
    padding-bottom: var(--space-20);
    background:
      radial-gradient(circle at 15% 10%, rgba(85,185,106,.08), transparent 28%),
      linear-gradient(180deg, #f8fbfa 0%, var(--clr-surface) 100%);
  }
  .demo-hero {
    display: grid;
    grid-template-columns: minmax(0,.82fr) minmax(560px,1.18fr);
    gap: var(--space-12);
    align-items: start;
  }
  .demo-copy { padding-top: var(--space-8); }
  .demo-eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: .12em;
    color: var(--clr-teal);
    margin-bottom: var(--space-4);
  }
  h1 {
    font-size: clamp(2.25rem,5vw,4.25rem);
    letter-spacing: -.045em;
    color: var(--clr-navy);
    margin-bottom: var(--space-5);
  }
  .demo-copy > p {
    font-size: var(--text-lg);
    color: var(--clr-text-soft);
    line-height: 1.7;
    max-width: 52ch;
  }
  .demo-points {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .demo-points > div {
    display: grid;
    gap: 2px;
    padding-left: var(--space-4);
    border-left: 3px solid var(--clr-amber);
  }
  .demo-points strong { color: var(--clr-navy); font-size: var(--text-sm); }
  .demo-points span { color: var(--clr-text-soft); font-size: var(--text-sm); line-height: 1.5; }
  .scheduler-shell {
    background: #0f172a;
    border: 1px solid rgba(11,39,72,.14);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(11,39,72,.18);
    min-height: 760px;
  }
  .scheduler-shell iframe {
    display: block;
    width: 100%;
    min-height: 760px;
    border: 0;
    background: #0f172a;
  }
  @media (max-width: 980px) {
    .demo-hero { grid-template-columns: 1fr; }
    .demo-copy { padding-top: 0; }
    .scheduler-shell, .scheduler-shell iframe { min-height: 820px; }
  }
  @media (max-width: 640px) {
    .demo-page { padding-top: calc(64px + var(--space-8)); }
    .scheduler-shell { margin-left: calc(var(--space-4) * -1); margin-right: calc(var(--space-4) * -1); border-radius: 14px; }
  }
</style>
