---
import BaseLayout from '../layouts/BaseLayout.astro'

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Schedule a Camvella Demo",
  "url": "https://camvella.com/demo",
  "description": "Book a personalized Camvella product demo using real-time availability."
}
---

<BaseLayout
  title="Book a Camvella Demo"
  description="Choose a real available date and time for a personalized Camvella walkthrough built around your communities, team, and workflows."
  schema={schema}
>
  <main class="demo-page">
    <section class="demo-hero container">
      <div class="demo-copy">
        <span class="demo-eyebrow">PERSONALIZED CAMVELLA DEMO</span>
        <h1>See your community workflows inside Camvella.</h1>
        <p>Choose a real available time for a focused 30-minute walkthrough. We’ll tailor the demo around your portfolio, accounting, compliance, board, resident, maintenance, and communication workflows.</p>

        <div class="demo-points" aria-label="Demo booking benefits">
          <div><strong>Real availability</strong><span>Choose from appointment times that are actually open.</span></div>
          <div><strong>Built around your workflow</strong><span>Bring a real community or process and we’ll walk it through Camvella.</span></div>
          <div><strong>Immediate confirmation</strong><span>Your appointment is reserved through the RomyLabs booking system and confirmed automatically.</span></div>
        </div>

        <div class="demo-trust">
          <span>30 minutes</span>
          <span>No sales deck marathon</span>
          <span>Real product walkthrough</span>
        </div>
      </div>

      <div class="scheduler-card">
        <div class="scheduler-card__header">
          <div>
            <span class="scheduler-card__eyebrow">Schedule your walkthrough</span>
            <strong>Pick a date and time</strong>
          </div>
          <span class="scheduler-card__secure">Live availability</span>
        </div>

        <div class="scheduler-shell" aria-label="Camvella demo scheduler">
          <div class="scheduler-loading" id="scheduler-loading" aria-hidden="true">
            <span class="scheduler-spinner"></span>
            <span>Loading available times…</span>
          </div>
          <iframe
            id="camvella-scheduler"
            title="Schedule a Camvella Demo"
            src="https://taxrescrm.app/book?product=camvella"
            loading="eager"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>

        <p class="scheduler-fallback">
          Having trouble with the scheduler?
          <a href="https://taxrescrm.app/book?product=camvella" target="_blank" rel="noopener">Open booking in a new tab →</a>
        </p>
      </div>
    </section>
  </main>

  <script is:inline>
    const frame = document.getElementById('camvella-scheduler');
    const loading = document.getElementById('scheduler-loading');
    if (frame && loading) {
      frame.addEventListener('load', () => loading.classList.add('is-hidden'), { once: true });
      window.setTimeout(() => loading.classList.add('is-hidden'), 7000);
    }
  </script>
</BaseLayout>

<style>
  .demo-page {
    min-height: 100vh;
    padding-top: calc(64px + var(--space-12));
    padding-bottom: var(--space-20);
    background:
      radial-gradient(circle at 12% 8%, rgba(85,185,106,.10), transparent 26%),
      radial-gradient(circle at 92% 20%, rgba(11,143,156,.08), transparent 30%),
      linear-gradient(180deg, #f7fbfa 0%, #ffffff 58%, var(--clr-surface) 100%);
  }
  .demo-hero {
    display: grid;
    grid-template-columns: minmax(0,.78fr) minmax(560px,1.22fr);
    gap: clamp(2rem,5vw,4.5rem);
    align-items: start;
  }
  .demo-copy { padding-top: var(--space-8); position: sticky; top: 96px; }
  .demo-eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 .7rem;
    border-radius: 999px;
    background: rgba(11,143,156,.08);
    border: 1px solid rgba(11,143,156,.14);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .11em;
    color: var(--clr-teal);
    margin-bottom: var(--space-5);
  }
  h1 {
    font-size: clamp(2.35rem,4.8vw,4.5rem);
    line-height: 1.02;
    letter-spacing: -.05em;
    color: var(--clr-navy);
    margin-bottom: var(--space-5);
    max-width: 11ch;
  }
  .demo-copy > p {
    font-size: var(--text-lg);
    color: var(--clr-text-soft);
    line-height: 1.72;
    max-width: 54ch;
  }
  .demo-points {
    display: grid;
    gap: 14px;
    margin-top: var(--space-8);
  }
  .demo-points > div {
    display: grid;
    gap: 3px;
    padding: 13px 15px;
    background: rgba(255,255,255,.72);
    border: 1px solid rgba(11,39,72,.08);
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(11,39,72,.035);
  }
  .demo-points strong { color: var(--clr-navy); font-size: var(--text-sm); }
  .demo-points span { color: var(--clr-text-soft); font-size: 13px; line-height: 1.5; }
  .demo-trust {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }
  .demo-trust span {
    font-size: 11px;
    font-weight: 750;
    color: var(--clr-text-mid);
    background: #fff;
    border: 1px solid var(--clr-border);
    border-radius: 999px;
    padding: 6px 9px;
  }
  .scheduler-card {
    background: #fff;
    border: 1px solid rgba(11,39,72,.10);
    border-radius: 22px;
    box-shadow: 0 28px 70px rgba(11,39,72,.16);
    overflow: hidden;
  }
  .scheduler-card__header {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    padding: 18px 20px;
    background: linear-gradient(135deg,#0B2748,#10385f);
    color: #fff;
  }
  .scheduler-card__header > div { display: grid; gap: 2px; }
  .scheduler-card__header strong { font-size: 16px; }
  .scheduler-card__eyebrow {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: rgba(255,255,255,.58);
    font-weight: 800;
  }
  .scheduler-card__secure {
    font-size: 10px;
    font-weight: 800;
    color: #b8f1c4;
    background: rgba(85,185,106,.12);
    border: 1px solid rgba(126,207,144,.24);
    border-radius: 999px;
    padding: 6px 9px;
    white-space: nowrap;
  }
  .scheduler-shell {
    position: relative;
    background: #0f172a;
    min-height: 760px;
  }
  .scheduler-shell iframe {
    display: block;
    width: 100%;
    min-height: 760px;
    border: 0;
    background: #0f172a;
  }
  .scheduler-loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 12px;
    background: #0f172a;
    color: rgba(255,255,255,.72);
    font-size: 13px;
    transition: opacity .2s ease, visibility .2s ease;
  }
  .scheduler-loading.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
  .scheduler-spinner {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 3px solid rgba(255,255,255,.15);
    border-top-color: var(--clr-amber);
    animation: scheduler-spin .8s linear infinite;
  }
  @keyframes scheduler-spin { to { transform: rotate(360deg); } }
  .scheduler-fallback {
    margin: 0;
    padding: 12px 18px 14px;
    border-top: 1px solid var(--clr-border-soft);
    color: var(--clr-text-soft);
    font-size: 12px;
    text-align: center;
  }
  .scheduler-fallback a { color: var(--clr-teal); font-weight: 750; }
  @media (max-width: 980px) {
    .demo-hero { grid-template-columns: 1fr; }
    .demo-copy { padding-top: 0; position: static; }
    h1 { max-width: 14ch; }
    .scheduler-shell, .scheduler-shell iframe { min-height: 820px; }
  }
  @media (max-width: 640px) {
    .demo-page { padding-top: calc(64px + var(--space-8)); padding-bottom: var(--space-12); }
    .demo-hero { gap: var(--space-8); }
    .scheduler-card { margin-left: calc(var(--space-4) * -1); margin-right: calc(var(--space-4) * -1); border-radius: 14px; }
    .scheduler-card__header { padding: 15px 14px; }
    .scheduler-shell, .scheduler-shell iframe { min-height: 850px; }
    .scheduler-fallback { padding-inline: 14px; }
  }
</style>
