---
import BaseLayout from '../layouts/BaseLayout.astro'

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Request a Camvella Demo",
  "url": "https://camvella.com/demo",
  "description": "Schedule a demo of Camvella HOA management software for your professional management company."
}
---

<BaseLayout
  title="Request a Demo — Camvella HOA Management Software"
  description="Schedule a personalized walkthrough of Camvella for your management company. We'll show you violations, financials, board operations, and the resident portal against a real portfolio."
  schema={schema}
>
  <div style="padding-top: 64px; min-height: 100vh; background: var(--clr-surface);">
    <div class="container" style="padding-top: var(--space-16); padding-bottom: var(--space-24);">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: start; max-width: 960px; margin: 0 auto;">

        <!-- Left: context -->
        <div>
          <h1 style="font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 800; letter-spacing: -0.03em; color: var(--clr-navy); margin-bottom: var(--space-4); line-height: 1.15;">
            See how it handles your portfolio.
          </h1>
          <p style="font-size: var(--text-base); color: var(--clr-text-soft); line-height: 1.65; margin-bottom: var(--space-8);">
            A 30-minute walkthrough tailored to your communities, team structure, and the features that matter most to you.
          </p>

          <div style="display: flex; flex-direction: column; gap: var(--space-5);">
            {[
              { icon: null, svgIcon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3L17.5 16.5H2.5L10 3Z" stroke="#0B2748" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 8v3.5M10 13.5v.5" stroke="#55B96A" stroke-width="1.5" stroke-linecap="round"/></svg>`, title: "Violations & ARC", body: "Live walkthrough of the violation lifecycle and ARC board voting." },
              { icon: null, svgIcon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2" y="4" width="16" height="12" rx="1.5" stroke="#0B2748" stroke-width="1.5"/><path d="M2 8h16" stroke="#0B8F9C" stroke-width="1.5"/><path d="M5 12h3M5 14.5h2" stroke="#55B96A" stroke-width="1.5" stroke-linecap="round"/></svg>`, title: "Financial Accounting", body: "Assessment billing, AR aging, AP management, balance sheet — all in one system." },
              { icon: null, svgIcon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2" y="2" width="7" height="7" rx="1.5" stroke="#0B2748" stroke-width="1.5"/><rect x="11" y="2" width="7" height="7" rx="1.5" stroke="#0B8F9C" stroke-width="1.5"/><rect x="2" y="11" width="7" height="7" rx="1.5" stroke="#0B8F9C" stroke-width="1.5"/><rect x="11" y="11" width="7" height="7" rx="1.5" stroke="#0B2748" stroke-width="1.5"/></svg>`, title: "Board Operations", body: "Meeting management, resolutions, minutes, and the board financial portal." },
              { icon: null, svgIcon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="5" y="2" width="10" height="16" rx="2" stroke="#0B2748" stroke-width="1.5"/><circle cx="10" cy="7.5" r="2" stroke="#55B96A" stroke-width="1.5"/><path d="M7 13c0-1.7 1.3-3 3-3s3 1.3 3 3" stroke="#55B96A" stroke-width="1.5" stroke-linecap="round"/></svg>`, title: "Resident Portal", body: "Mobile-first self-service for violation status, ARC submissions, and statements." },
            ].map(item => (
              <div style="display: flex; align-items: flex-start; gap: var(--space-4);">
                <span style="width:20px;height:20px;flex-shrink:0;" set:html={item.svgIcon}></span>
                <div>
                  <p style="font-size: var(--text-sm); font-weight: 700; color: var(--clr-navy); margin-bottom: var(--space-1);">{item.title}</p>
                  <p style="font-size: var(--text-sm); color: var(--clr-text-soft); line-height: 1.5;">{item.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: form -->
        <div style="background: white; padding: var(--space-8); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); border: 1px solid var(--clr-border);">
          <h2 style="font-size: var(--text-xl); font-weight: 800; color: var(--clr-navy); margin-bottom: var(--space-6);">
            Request your demo
          </h2>

          <form
            id="demo-form"
            novalidate
            aria-label="Demo request form"
          >
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="first_name">First name <span aria-hidden="true">*</span></label>
                <input class="form-input" type="text" id="first_name" name="first_name" required autocomplete="given-name" />
              </div>
              <div class="form-group">
                <label class="form-label" for="last_name">Last name <span aria-hidden="true">*</span></label>
                <input class="form-input" type="text" id="last_name" name="last_name" required autocomplete="family-name" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="email">Work email <span aria-hidden="true">*</span></label>
              <input class="form-input" type="email" id="email" name="email" required autocomplete="work email" inputmode="email" placeholder="you@yourcompany.com" />
              <p id="email-error" style="font-size: var(--text-xs); color: var(--clr-danger); margin-top: var(--space-1); display: none;" role="alert">Please use a work email address.</p>
            </div>

            <div class="form-group">
              <label class="form-label" for="company">Management company name <span aria-hidden="true">*</span></label>
              <input class="form-input" type="text" id="company" name="company" required autocomplete="organization" />
            </div>

            <div class="form-group">
              <label class="form-label" for="communities">Communities managed <span aria-hidden="true">*</span></label>
              <select class="form-select" id="communities" name="communities" required>
                <option value="">Select range</option>
                <option value="1-5">1 – 5</option>
                <option value="6-15">6 – 15</option>
                <option value="16-50">16 – 50</option>
                <option value="50+">50+</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="phone">Phone (optional)</label>
              <input class="form-input" type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" />
            </div>

            <div class="form-group">
              <label class="form-label" for="how_heard">How did you hear about us?</label>
              <select class="form-select" id="how_heard" name="how_heard">
                <option value="">Select one</option>
                <option value="google">Google search</option>
                <option value="referral">Referral from a colleague</option>
                <option value="linkedin">LinkedIn</option>
                <option value="cai">CAI / industry event</option>
                <option value="other">Other</option>
              </select>
            </div>

            <button
              type="submit"
              class="btn btn--primary"
              style="width: 100%; margin-top: var(--space-2);"
              data-event="demo_form_submit"
            >
              Request Demo
            </button>

            <p style="font-size: var(--text-xs); color: var(--clr-text-soft); margin-top: var(--space-4); text-align: center; line-height: 1.5;">
              We'll reach out within one business day to schedule. No obligation, no sales pressure.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>

<script>
  const EDGE = 'https://fjqywulzsyfyzitneazb.supabase.co/functions/v1/submit-demo-lead';

  document.getElementById('demo-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('[type="submit"]');
    const errEl = document.getElementById('form-error');
    const fields = Object.fromEntries(new FormData(form).entries());

    // Capture UTM params from URL
    const sp = new URLSearchParams(window.location.search);
    fields.utm_source   = sp.get('utm_source')   || '';
    fields.utm_medium   = sp.get('utm_medium')   || '';
    fields.utm_campaign = sp.get('utm_campaign') || '';
    fields.source_page  = window.location.pathname;

    // Client-side required check
    const required = ['first_name','last_name','email','company','communities'];
    const missing = required.filter(f => !fields[f]?.trim());
    if (missing.length) {
      if (errEl) { errEl.textContent = 'Please fill in all required fields.'; errEl.hidden = false; }
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Submitting…';
    if (errEl) errEl.hidden = true;

    // Fire GA4 event
    if (typeof gtag === 'function') gtag('event', 'demo_form_submit', { event_category: 'conversion' });

    try {
      const res = await fetch(EDGE, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(fields),
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.href = '/demo/thank-you';
      } else {
        const msg = data.error || 'Something went wrong. Please try again.';
        if (errEl) { errEl.textContent = msg; errEl.hidden = false; }
        btn.disabled = false;
        btn.textContent = 'Request a Demo';
      }
    } catch (err) {
      if (errEl) { errEl.textContent = 'Network error. Please try again.'; errEl.hidden = false; }
      btn.disabled = false;
      btn.textContent = 'Request a Demo';
    }
  });
</script>

</BaseLayout>

<script>
  const form = document.getElementById('demo-form') as HTMLFormElement
  const emailInput = document.getElementById('email') as HTMLInputElement
  const emailError = document.getElementById('email-error') as HTMLElement
  const PERSONAL_DOMAINS = ['gmail','yahoo','hotmail','outlook','icloud','aol','protonmail']

  if (form && emailInput && emailError) {
    // Track form start
    let started = false
    form.addEventListener('focusin', () => {
      if (!started) {
        started = true
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'demo_form_start')
        }
      }
    }, { once: false })

    form.addEventListener('submit', (e) => {
      const email = emailInput.value.toLowerCase()
      const domain = email.split('@')[1]?.split('.')[0] ?? ''
      if (PERSONAL_DOMAINS.includes(domain)) {
        e.preventDefault()
        emailError.style.display = 'block'
        emailInput.focus()
        return
      }
      emailError.style.display = 'none'
    })

    emailInput.addEventListener('input', () => {
      emailError.style.display = 'none'
    })
  }
</script>

<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
