---
import BaseLayout from '../../layouts/BaseLayout.astro'
---
<BaseLayout
  title="Camvella Vs Vantaca | Camvella"
  description="Honest comparison — Camvella Vs Vantaca. Every claim is sourced from vendor documentation or verified user reviews."
>
  <div style="padding-top: calc(64px + var(--space-16)); padding-bottom: var(--space-8); background: var(--clr-navy); color: white;">
    <div class="container">
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; max-width: 26ch; margin-bottom: var(--space-4); line-height: 1.1;">Camvella Vs Vantaca</h1>
      <p style="font-size: var(--text-lg); color: rgba(255 255 255 / 0.75); max-width: 52ch; line-height: 1.65;">This detailed comparison page is being built with freshly researched, source-verified competitive claims. Check back soon, or book a demo to discuss platform options directly.</p>
    </div>
  </div>
  <section class="section">
    <div class="container container--narrow" style="text-align: center;">
      <p style="font-size: var(--text-lg); color: var(--clr-text-soft); margin-bottom: var(--space-8); line-height: 1.65;">For a personalized walkthrough comparing Camvella to your current platform, book a demo. We'll address your specific questions directly.</p>
      <a href="/demo" class="btn btn--primary btn--lg" data-event="comparison_page_view">Book a Demo</a>
    </div>
  </section>
</BaseLayout>
