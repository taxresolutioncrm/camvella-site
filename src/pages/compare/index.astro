---
import BaseLayout from '../../layouts/BaseLayout.astro'

const comparisons = [
  { href: "/compare/camvella-vs-cinc", label: "Camvella vs CINC Systems", desc: "Compare product focus, implementation approach, HOA workflows, financial operations, and fit for professional management companies." },
]
---

<BaseLayout
  title="HOA Software Comparisons | Camvella"
  description="An honest comparison of Camvella and CINC Systems for professional HOA and community association management companies."
>
  <div style="padding-top: calc(64px + var(--space-16)); padding-bottom: var(--space-8); background: var(--clr-navy); color: white;">
    <div class="container">
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; max-width: 22ch; margin-bottom: var(--space-4); line-height: 1.1;">Honest comparisons.</h1>
      <p style="font-size: var(--text-lg); color: rgba(255 255 255 / 0.75); max-width: 54ch; line-height: 1.65;">Our published comparisons focus on verifiable product differences and the practical needs of professional community association management companies. Additional comparisons will be published only after full editorial review.</p>
    </div>
  </div>

  <section class="section" aria-labelledby="compare-headline">
    <div class="container">
      <h2 class="visually-hidden" id="compare-headline">Comparison pages</h2>
      <div class="feature-grid">
        {comparisons.map(c => (
          <a href={c.href} class="feature-card" style="text-decoration: none; display: block;">
            <h3 class="feature-card__title">{c.label}</h3>
            <p class="feature-card__body">{c.desc}</p>
            <p style="font-size: var(--text-sm); font-weight: 600; color: var(--clr-navy); margin-top: var(--space-3);">Read comparison →</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
