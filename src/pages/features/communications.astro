---
import BaseLayout from '../../layouts/BaseLayout.astro'
---
<BaseLayout
  title="HOA Communication Software | Camvella"
  description="HOA communication tools for professional management companies. Email and SMS to residents, owners, and boards — with templates, delivery tracking, and audience targeting."
>
  <div style="padding-top: calc(64px + var(--space-16)); padding-bottom: var(--space-8); background: var(--clr-navy); color: white;">
    <div class="container">
      <p style="font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--clr-amber-light); margin-bottom: var(--space-3);">Communications</p>
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; max-width: 22ch; margin-bottom: var(--space-5); line-height: 1.1;">The right message to the right people. Not a mass blast to everyone.</h1>
      <p style="font-size: var(--text-lg); color: rgba(255 255 255 / 0.75); max-width: 52ch; margin-bottom: var(--space-8); line-height: 1.65;">Email and SMS with audience targeting — association-wide, building-specific, unit-specific, or individual. Templates. Delivery tracking. No limit on message frequency.</p>
      <a href="/demo" class="btn btn--primary btn--lg" data-event="feature_page_cta_click">Book a Demo</a>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="feature-grid">
        {[
          { title: "Email & SMS", body: "Reach residents by email or SMS from one compose window. Brevo powers email delivery. Telnyx powers SMS. Both tracked." },
          { title: "Audience Targeting", body: "Send to an entire association, a specific building, a single unit, or individual owners and residents. No list management required." },
          { title: "Templates", body: "Save message templates for recurring communications — late assessment notices, violation notices, meeting announcements, seasonal reminders." },
          { title: "Merge Fields", body: "Personalize messages with owner name, unit number, community name, and balance — populated automatically from the database." },
          { title: "Delivery Tracking", body: "See which recipients received, opened, or failed. Delivery receipts come back from Brevo and Telnyx webhooks." },
          { title: "Communication History", body: "Every message sent to every recipient, searchable and filterable. Your team always knows what was sent when." },
        ].map(f => (
          <div class="feature-card">
            <h3 class="feature-card__title">{f.title}</h3>
            <p class="feature-card__body">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--alt">
    <div class="container container--narrow" style="text-align: center;">
      <h2 class="section__headline">What Camvella communications won't do</h2>
      <p class="section__subhead" style="margin: var(--space-4) auto 0; text-align: center;">No two-way SMS threading in V1. No scheduled campaigns. No email open/click rate dashboard (delivery receipts yes, analytics dashboard no). We're being specific because you deserve an honest feature list.</p>
    </div>
  </section>
  <section class="section section--dark">
    <div class="container" style="text-align: center;">
      <h2 style="font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; color: white; margin-bottom: var(--space-4);">See communications in your demo.</h2>
      <a href="/demo" class="btn btn--primary btn--lg" data-event="demo_cta_click">Book a Demo</a>
    </div>
  </section>
</BaseLayout>
