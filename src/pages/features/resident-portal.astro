---
import BaseLayout from '../../layouts/BaseLayout.astro'
---
<BaseLayout
  title="Resident Portal | Camvella HOA Software"
  description="Camvella HOA management — resident portal feature details. Book a demo to see it in action."
>
  <div style="padding-top: calc(64px + var(--space-16)); padding-bottom: var(--space-8); background: var(--clr-navy); color: white;">
    <div class="container">
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; max-width: 22ch; margin-bottom: var(--space-5); line-height: 1.1; color: white;">Resident Portal</h1>
      <p style="font-size: var(--text-lg); color: rgba(255 255 255 / 0.75); max-width: 52ch; margin-bottom: var(--space-8); line-height: 1.65;">Full details on this feature are available in a personalized demo. Book a walkthrough to see exactly how it works for your management company.</p>
      <a href="/demo" class="btn btn--primary btn--lg" data-event="feature_page_cta_click">Book a Demo</a>
    </div>
  </div>
  <section class="section">
    <div class="container container--narrow" style="text-align: center;">
      <p style="font-size: var(--text-lg); color: var(--clr-text-soft); line-height: 1.65; margin-bottom: var(--space-8);">This page is being built. For detailed feature information, book a demo and we'll walk you through everything live.</p>
      <a href="/product" class="btn btn--dark">See Product Overview</a>
    </div>
  </section>
</BaseLayout>
