---
import BaseLayout from '../../layouts/BaseLayout.astro'
---
<BaseLayout
  title="HOA Work Order & Maintenance Software | Camvella"
  description="HOA maintenance and work order management. Submit, assign, track, and close maintenance requests from one place — with vendor tracking and photo documentation."
>
  <div style="padding-top: calc(64px + var(--space-16)); padding-bottom: var(--space-8); background: var(--clr-navy); color: white;">
    <div class="container">
      <p style="font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--clr-amber-light); margin-bottom: var(--space-3);">Work Orders & Maintenance</p>
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; max-width: 22ch; margin-bottom: var(--space-5); line-height: 1.1;">From submitted to closed — without the follow-up chaos.</h1>
      <p style="font-size: var(--text-lg); color: rgba(255 255 255 / 0.75); max-width: 52ch; margin-bottom: var(--space-8); line-height: 1.65;">Work orders that know their status, their vendor, and their history. No more "who's handling the pool pump?" answered by searching email.</p>
      <a href="/demo" class="btn btn--primary btn--lg" data-event="feature_page_cta_click">Book a Demo</a>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="feature-grid">
        {[
          { title: "Full Status Lifecycle", body: "Submitted → Assigned → In Progress → Completed → Closed. Every transition timestamped. No work order falls through the cracks." },
          { title: "Vendor Assignment", body: "Assign work orders to vendors in your vendor database. Vendors are tracked with insurance compliance and expiry alerts." },
          { title: "Photo Attachments", body: "Attach photos at any stage. Before-and-after documentation for every maintenance job." },
          { title: "AI Categorization", body: "AI-assisted work order categorization and priority suggestion. Your team reviews before acting." },
          { title: "Resident Submission", body: "Residents submit service requests from the mobile portal. They track status without calling your office." },
          { title: "Work Order Reports", body: "Open work orders, overdue jobs, vendor activity, and completion rate — all in the reporting module." },
        ].map(f => (
          <div class="feature-card">
            <h3 class="feature-card__title">{f.title}</h3>
            <p class="feature-card__body">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="screen-frame" style="max-width: 900px; margin: 0 auto;" aria-label="Camvella Work Orders screen">
        <div class="screen-frame__bar" aria-hidden="true">
          <div class="screen-frame__dot"></div><div class="screen-frame__dot"></div><div class="screen-frame__dot"></div>
        </div>
        <img
          src="/screenshots/work-orders.webp"
          alt="Camvella work order management screen showing open WOs, vendor assignments, and status tracking"
          width="900" height="562"
          loading="lazy"
          style="width:100%;height:auto;display:block;border-radius:4px;"
        />
      </div>
    </div>
  </section>
  <section class="section section--dark">
    <div class="container" style="text-align: center;">
      <h2 style="font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; color: white; margin-bottom: var(--space-4);">See work orders in your demo.</h2>
      <a href="/demo" class="btn btn--primary btn--lg" data-event="demo_cta_click">Book a Demo</a>
    </div>
  </section>
</BaseLayout>
