---
import BaseLayout from '../layouts/BaseLayout.astro'

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://camvella.com/#software",
  "name": "Camvella",
  "alternateName": "Camvella HOA Management Software",
  "applicationCategory": "BusinessApplication",
  "applicationSubCategory": "HOA and Community Association Management Software",
  "operatingSystem": "Web",
  "description": "Camvella is HOA and community association management software for professional CAM companies, with accounting, violations, ARC workflows, board operations, resident portals, work orders, communications, and automation.",
  "url": "https://camvella.com/",
  "featureList": [
    "HOA accounting",
    "Violation management",
    "Architectural review workflows",
    "Board portal",
    "Resident portal",
    "Work orders and vendor management",
    "Email and SMS communications",
    "Workflow automation"
  ],
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "offerCount": "3"
  }
}

const capabilities = [
  {
    num: "01",
    title: "Property & Compliance",
    body: "Associations, units, owners, residents. Violations with full notice lifecycle. ARC requests with board voting. Everything your team touches, in one place."
  },
  {
    num: "02",
    title: "Financial Accounting",
    body: "Purpose-built HOA accounting: AR, AP, assessment schedules, late fees, GL, balance sheet, budgeting. Not repurposed from rental software."
  },
  {
    num: "03",
    title: "Board & Resident Portals",
    body: "Board meetings, resolutions, minutes, and financial reports. Residents get a mobile-first portal for violations, ARC, service requests, and statements."
  },
  {
    num: "04",
    title: "Work Orders & Vendors",
    body: "Maintenance from submission to completion. Vendor database with insurance compliance tracking and expiry alerts."
  },
  {
    num: "05",
    title: "Communications",
    body: "Email residents and owners, owners, and boards. Templates, audience targeting, delivery tracking. Powered by Brevo and Telnyx."
  },
  {
    num: "06",
    title: "Automation",
    body: "Violation notices, reinspection reminders, ARC decision notifications, work order completion follow-ups — running without anyone remembering to trigger them."
  },
]

const finFeatures = [
  "Assessment schedules with automatic billing runs",
  "Late fee automation with configurable grace periods",
  "AR aging reports and unit statements",
  "Write-off workflow with audit trail",
  "Full AP bill lifecycle: draft → approved → paid",
  "GL detail, balance sheet, income statement",
  "Budget management with board approval workflow",
  "Board-accessible read-only financial views",
]

const faqs = [
  {
    q: "What does Camvella cost?",
    a: "Camvella offers transparent per-community pricing. Book a demo and we'll walk you through exact pricing for your portfolio size — no hidden fees, no transaction charges on top of your subscription."
  },
  {
    q: "Can it handle multiple associations?",
    a: "Yes. Camvella is built for professional management companies running multiple communities. Every association's financials, residents, and operations are fully isolated from each other within a single login."
  },
  {
    q: "Does it have a resident-facing portal?",
    a: "Yes. Residents get a mobile-first portal where they can view violation status, submit ARC requests, track service requests, access their account statement, and update their profile."
  },
  {
    q: "How does the financial accounting work?",
    a: "Camvella has a full HOA accounting layer built specifically for fund accounting: AR with assessment schedules, AP with bill management, GL with journal entries, balance sheet, income statement, and budget vs. actual reporting."
  },
  {
    q: "Is there a mobile app?",
    a: "Camvella is a responsive web application that works on iOS Safari and Android Chrome. The resident portal is built mobile-first. There is no separate native app to download."
  },
  {
    q: "How long does setup take?",
    a: "Most management companies are operational within a few days of signing up. We walk you through adding your first association, units, and users. No 30-day implementation program required."
  },
  {
    q: "What happens to my data if I cancel?",
    a: "Your data belongs to you. You can export your associations, units, owner records, and financial history at any time. We do not hold data hostage."
  },
]
---

<BaseLayout
  title="HOA & Community Association Management Software | Camvella"
  description="Camvella is HOA and community association management software for professional CAM companies. Manage accounting, violations, ARC, boards, residents, work orders, communications, and automation in one platform."
  schema={schema}
>
  <!-- ─── Hero ──────────────────────────────────────────────────────────── -->
  <section class="hero" aria-label="Hero">
    <div class="container">
      <div class="hero__two-col"><div class="hero__left">
      <div class="hero__eyebrow" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor">
          <circle cx="5" cy="5" r="4"/>
        </svg>
        Built for professional CAM teams
      </div>

      <h1 class="hero__headline">
        HOA management software <em>built for professional CAM teams.</em>
      </h1>

      <p class="hero__body">
        Modern community association management software for teams that need operations, accounting, boards, residents, and communications in one platform — without enterprise bloat.
      </p>

      <div class="hero__actions">
        <a
          href="/demo"
          class="btn btn--primary btn--lg"
          data-event="demo_cta_click"
        >
          Book a Demo
        </a>
        <a
          href="/product"
          class="btn btn--lg"
          style="background: rgba(255 255 255 / 0.08); color: white; border: 1px solid rgba(255 255 255 / 0.15);"
        >
          See the Product
        </a>
      </div>


      <div style="margin-top: var(--space-16);">
        <div class="hero-modules" aria-label="Camvella module overview">
          <div class="hero-module-grid">
            <div class="hero-module-card">
              <div class="hero-module-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3L17.5 16.5H2.5L10 3Z" stroke="#0B2748" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 8v3.5M10 13.5v.5" stroke="#55B96A" stroke-width="1.5" stroke-linecap="round"/></svg></div>
              <div><p class="hero-module-label">Violations</p><p class="hero-module-sub">Full lifecycle · notices · fines</p></div>
            </div>
            <div class="hero-module-card">
              <div class="hero-module-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="2" stroke="#0B2748" stroke-width="1.5"/><path d="M7 10l2.5 2.5L13 7" stroke="#55B96A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
              <div><p class="hero-module-label">ARC Requests</p><p class="hero-module-sub">Board voting · document tracking</p></div>
            </div>
            <div class="hero-module-card">
              <div class="hero-module-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2" y="4" width="16" height="12" rx="1.5" stroke="#0B2748" stroke-width="1.5"/><path d="M2 8h16" stroke="#0B8F9C" stroke-width="1.5"/><path d="M5 12h3M5 14.5h2" stroke="#55B96A" stroke-width="1.5" stroke-linecap="round"/></svg></div>
              <div><p class="hero-module-label">HOA Accounting</p><p class="hero-module-sub">AR · AP · GL · budgets</p></div>
            </div>
            <div class="hero-module-card">
              <div class="hero-module-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M13 4l3 3-8 8-3.5.5.5-3.5L13 4z" stroke="#0B2748" stroke-width="1.5" stroke-linejoin="round"/><path d="M11.5 5.5l3 3" stroke="#55B96A" stroke-width="1.5" stroke-linecap="round"/></svg></div>
              <div><p class="hero-module-label">Work Orders</p><p class="hero-module-sub">Assignment · tracking · vendors</p></div>
            </div>
            <div class="hero-module-card">
              <div class="hero-module-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2" y="2" width="7" height="7" rx="1.5" stroke="#0B2748" stroke-width="1.5"/><rect x="11" y="2" width="7" height="7" rx="1.5" stroke="#0B8F9C" stroke-width="1.5"/><rect x="2" y="11" width="7" height="7" rx="1.5" stroke="#0B8F9C" stroke-width="1.5"/><rect x="11" y="11" width="7" height="7" rx="1.5" stroke="#0B2748" stroke-width="1.5"/></svg></div>
              <div><p class="hero-module-label">Board Portal</p><p class="hero-module-sub">Meetings · resolutions · financials</p></div>
            </div>
            <div class="hero-module-card">
              <div class="hero-module-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="5" y="2" width="10" height="16" rx="2" stroke="#0B2748" stroke-width="1.5"/><circle cx="10" cy="7.5" r="2" stroke="#55B96A" stroke-width="1.5"/><path d="M7 13c0-1.7 1.3-3 3-3s3 1.3 3 3" stroke="#55B96A" stroke-width="1.5" stroke-linecap="round"/></svg></div>
              <div><p class="hero-module-label">Resident Portal</p><p class="hero-module-sub">Mobile-first · violations · ARC</p></div>
            </div>
          </div>
        </div>
      </div>

        </div><!-- /hero__left -->


        <div class="hero__right" aria-label="Camvella product overview">
          <div class="hero__visual-frame">
            <div class="hero__visual-bar" aria-hidden="true">
              <span class="hero__visual-dot"></span>
              <span class="hero__visual-dot"></span>
              <span class="hero__visual-dot"></span>
              <span class="hero__visual-url">app.camvella.com</span>
            </div>
            <img
                src="/screenshots/dashboard.svg"
                alt="Camvella dashboard showing KPI metrics, open violations, ARC requests and work orders"
                width="680" height="432"
                loading="eager"
                style="width:100%;height:auto;display:block;border-radius:4px;"
              />
          </div>
        </div><!-- /hero__right -->
      </div><!-- /hero__two-col -->

      <div class="hero__trust">
        <span class="hero__trust-item">
          <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 10.7 4.2 12.8l.7-4.3L1.8 5.5l4.3-.6L8 1z"/></svg>
          HOA-specific from day one
        </span>
        <span class="hero__trust-item">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 8h12M2 4h12M2 12h7" stroke-linecap="round"/></svg>
          Full financial accounting included
        </span>
        <span class="hero__trust-item">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="12" height="12" rx="2"/><path d="M5 8l2.5 2.5L11 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Operational in days, not months
        </span>
      </div>
    </div>
  </section>

  <!-- ─── Capabilities ─────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="cap-headline">
    <div class="container">
      <p class="section__label">What Camvella covers</p>
      <h2 class="section__headline" id="cap-headline">The full operating stack for professional management</h2>
      <p class="section__subhead">
        Every module your team uses, built specifically for HOA and community association management — not adapted from a rental property platform.
      </p>

      <div class="cap-strip" role="list">
        {capabilities.map(cap => (
          <div class="cap-item" role="listitem">
            <p class="cap-item__num">{cap.num}</p>
            <p class="cap-item__title">{cap.title}</p>
            <p class="cap-item__body">{cap.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Financial Accounting ──────────────────────────────────────────── -->
  <section class="section section--alt" aria-labelledby="fin-headline">
    <div class="container">
      <div class="accounting-showcase">
        <div class="accounting-showcase__copy">
          <p class="section__label">Financial management</p>
          <h2 class="section__headline" id="fin-headline">
            Built for HOA accounting — not adapted from it.
          </h2>
          <p class="section__subhead">
            Most HOA software treats accounting as a feature. Camvella treats it as a foundation. Full double-entry GL, fund accounting, AR/AP, budgeting, and board-ready reporting live in one connected workflow.
          </p>

          <div class="accounting-showcase__pill-row" aria-label="Accounting capabilities">
            <span>Double-entry GL</span>
            <span>Fund accounting</span>
            <span>AR / AP</span>
            <span>Budgets</span>
          </div>

          <div class="accounting-showcase__feature-grid">
            {finFeatures.map(f => (
              <div class="accounting-showcase__feature">
                <span class="accounting-showcase__check" aria-hidden="true">✓</span>
                <span>{f}</span>
              </div>
            ))}
          </div>

          <div class="accounting-showcase__actions">
            <a href="/features/hoa-accounting" class="btn btn--dark" data-event="feature_page_cta_click">
              Explore HOA Accounting →
            </a>
            <a href="/demo" class="btn" data-event="demo_cta_click">
              Book a Demo
            </a>
          </div>
        </div>

        <div class="accounting-showcase__visual">
          <div class="accounting-showcase__visual-label">Live product view</div>
          <div class="screen-frame accounting-showcase__frame" aria-label="Financial reporting screenshot">
            <div class="screen-frame__bar" aria-hidden="true">
              <div class="screen-frame__dot"></div>
              <div class="screen-frame__dot"></div>
              <div class="screen-frame__dot"></div>
              <span class="accounting-showcase__url">app.camvella.com/financials</span>
            </div>
            <img
              src="/screenshots/financials.svg?v=20260905b"
              alt="Camvella financial dashboard with AR, AP, reserve balances, quick actions, and bills due soon"
              width="1280"
              height="800"
              loading="lazy"
              style="width:100%;height:auto;display:block;"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Three Audiences ───────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="audience-headline">
    <div class="container">
      <p class="section__label">Who it's for</p>
      <h2 class="section__headline" id="audience-headline">One system, three perspectives</h2>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); margin-top: var(--space-12);">
        <div style="padding: var(--space-6); border: 1px solid var(--clr-border); border-radius: var(--radius-lg);">
          <div style="width: 40px; height: 40px; background: var(--clr-navy); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M2 16V6l8-4 8 4v10" stroke="white" stroke-width="1.5" stroke-linecap="round"/><rect x="7" y="10" width="6" height="6" stroke="white" stroke-width="1.5"/></svg>
          </div>
          <h3 style="font-size: var(--text-base); font-weight: 700; color: var(--clr-navy); margin-bottom: var(--space-2);">For your management team</h3>
          <p style="font-size: var(--text-sm); color: var(--clr-text-soft); line-height: 1.6;">One login. Full portfolio visibility. Violations, work orders, financials, communications — without switching systems or looking up which spreadsheet has what.</p>
        </div>

        <div style="padding: var(--space-6); border: 1px solid var(--clr-border); border-radius: var(--radius-lg);">
          <div style="width: 40px; height: 40px; background: var(--clr-navy); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="4" stroke="white" stroke-width="1.5"/><path d="M2 18c0-4 3.6-7 8-7s8 3 8 7" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3 style="font-size: var(--text-base); font-weight: 700; color: var(--clr-navy); margin-bottom: var(--space-2);">For your boards</h3>
          <p style="font-size: var(--text-sm); color: var(--clr-text-soft); line-height: 1.6;">Meeting management, resolutions, minutes, and financial reports in a dedicated board portal. No spreadsheets emailed before meetings.</p>
        </div>

        <div style="padding: var(--space-6); border: 1px solid var(--clr-border); border-radius: var(--radius-lg);">
          <div style="width: 40px; height: 40px; background: var(--clr-navy); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="4" y="2" width="12" height="16" rx="2" stroke="white" stroke-width="1.5"/><path d="M7 7h6M7 10h6M7 13h4" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3 style="font-size: var(--text-base); font-weight: 700; color: var(--clr-navy); margin-bottom: var(--space-2);">For your residents</h3>
          <p style="font-size: var(--text-sm); color: var(--clr-text-soft); line-height: 1.6;">A mobile-first portal where residents can check violation status, submit ARC requests, track service requests, and view their account statement.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Positioning Statement ─────────────────────────────────────────── -->
  <section class="section section--alt" aria-labelledby="pos-headline">
    <div class="container">
      <div class="callout">
        <div>
          <h2 class="callout__headline" id="pos-headline">
            CINC and Vantaca are built for the <em>largest</em> companies. We're built for the rest.
          </h2>
          <p class="callout__body">
            Professional management companies managing 5 to 50 communities need real financial depth, modern software, and onboarding measured in days — not a 30-day implementation program and five months of optimization.
          </p>
          <a href="/demo" class="btn btn--primary btn--lg" data-event="demo_cta_click">
            See how it fits your team
          </a>
        </div>
        <div style="display: flex; flex-direction: column; gap: var(--space-4);">
          {[
            { label: "Communities managed", val: "5 – 50" },
            { label: "Time to operational", val: "Days" },
            { label: "Implementation fee", val: "$0" },
            { label: "Financial accounting", val: "Included" },
          ].map(item => (
            <div style="padding: var(--space-4); background: rgba(255 255 255 / 0.06); border-radius: var(--radius-md); border: 1px solid rgba(255 255 255 / 0.1);">
              <p style="font-size: var(--text-xs); color: rgba(255 255 255 / 0.5); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-1);">{item.label}</p>
              <p style="font-size: var(--text-xl); font-weight: 800; color: var(--clr-amber);">{item.val}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="faq-headline">
    <div class="container container--narrow">
      <h2 class="section__headline text-center" id="faq-headline">Common questions</h2>

      <div class="faq-list" role="list">
        {faqs.map((faq, i) => (
          <div class="faq-item" role="listitem">
            <button class="faq-q" aria-expanded="false" aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>
              {faq.q}
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
            <div class="faq-a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              {faq.a}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Bottom CTA ────────────────────────────────────────────────────── -->
  <section class="section section--dark" aria-labelledby="cta-headline">
    <div class="container" style="text-align: center;">
      <h2 class="section__headline" id="cta-headline" style="color: white;">
        See how it handles a real portfolio.
      </h2>
      <p class="section__subhead" style="margin: var(--space-4) auto var(--space-8); text-align: center;">
        We'll walk through your specific communities, team structure, and the features that matter most to you.
      </p>
      <a href="/demo" class="btn btn--primary btn--lg" data-event="demo_cta_click">
        Book a Demo
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  @media (max-width: 768px) {
    .hero__actions { flex-direction: column; }
    .hero__actions .btn { width: 100%; }
    div[style*="grid-template-columns: 1fr 1fr"],
    div[style*="grid-template-columns: repeat(3, 1fr)"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>


<style>
  .accounting-showcase {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(520px, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .accounting-showcase__copy .section__subhead {
    margin-bottom: var(--space-6);
  }
  .accounting-showcase__pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: var(--space-6);
  }
  .accounting-showcase__pill-row span {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 .75rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--clr-border);
    color: var(--clr-navy);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .accounting-showcase__feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .7rem 1rem;
  }
  .accounting-showcase__feature {
    display: flex;
    align-items: flex-start;
    gap: .55rem;
    color: var(--clr-text-mid);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .accounting-showcase__check {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    margin-top: 1px;
    background: rgba(22,163,74,.10);
    color: var(--clr-success);
    font-size: 11px;
    font-weight: 800;
  }
  .accounting-showcase__actions {
    display: flex;
    gap: .75rem;
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }
  .accounting-showcase__visual {
    position: relative;
  }
  .accounting-showcase__visual-label {
    position: absolute;
    z-index: 2;
    top: -12px;
    right: 18px;
    padding: .4rem .65rem;
    border-radius: 999px;
    background: var(--clr-navy);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .05em;
    text-transform: uppercase;
    box-shadow: 0 8px 24px rgba(11,39,72,.18);
  }
  .accounting-showcase__frame {
    aspect-ratio: auto;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: 0 28px 60px rgba(11,39,72,.18);
    border: 1px solid rgba(11,39,72,.10);
  }
  .accounting-showcase__url {
    margin-left: auto;
    margin-right: 10px;
    color: rgba(255,255,255,.62);
    font-size: 10px;
  }
  @media (max-width: 980px) {
    .accounting-showcase {
      grid-template-columns: 1fr;
    }
    .accounting-showcase__visual {
      order: 2;
    }
  }
