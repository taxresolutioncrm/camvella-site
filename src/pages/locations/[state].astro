---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { states } from '../../data/states'
export function getStaticPaths(){ return states.map(([slug,name])=>({params:{state:slug},props:{name}})) }
const { name } = Astro.props
const canonical = `https://camvella.com/locations/${Astro.params.state}/`
const schema={"@context":"https://schema.org","@type":"SoftwareApplication","name":"Camvella","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":canonical,"areaServed":{"@type":"State","name":name},"description":`HOA and community association management software for professional management companies serving communities in ${name}.`}
---
<BaseLayout title={`HOA Management Software in ${name} | Camvella`} description={`HOA and community association management software for professional CAM companies in ${name}. Connect accounting, violations, ARC, boards, residents, work orders, vendors, documents, communications, and reporting.`} canonical={canonical} schema={schema}>
<section class="hero"><div class="container"><p class="section__label">Nationwide HOA management software</p><h1>HOA management software for {name} community management companies.</h1><p>Camvella gives professional management companies serving associations across {name} one connected operating system for accounting, compliance, governance, resident service, maintenance, vendors, documents, and communication.</p><div class="actions"><a class="btn btn--primary btn--lg" href="/demo">Book a Demo</a><a class="btn btn--dark btn--lg" href="/solutions/hoa-management-software">Explore HOA Software</a></div></div></section>
<section class="section"><div class="container"><h2 class="section__headline">Built for multi-community operations in {name}.</h2><div class="grid"><article><h3>Association accounting</h3><p>Assessment billing, AR, AP, GL, budgets, statements, and financial reporting remain separated by association while staff work across a portfolio.</p></article><article><h3>Compliance & ARC</h3><p>Track inspections, notices, fines, architectural requests, committee review, decisions, attachments, and resident communication in one history.</p></article><article><h3>Boards & residents</h3><p>Give boards controlled access to governance and financial records while residents use mobile self-service for requests, documents, statements, and updates.</p></article><article><h3>Work orders & vendors</h3><p>Coordinate requests, vendor assignment, documents, insurance records, status changes, and completion history from the same community record.</p></article></div></div></section>
<section class="section section--alt"><div class="container container--narrow"><h2 class="section__headline">A national platform, not a single-market product.</h2><p class="section__subhead">Camvella is built for professional community association management companies operating anywhere in the United States. This {name} page is part of a nationwide state-by-state search structure so management teams can find software aligned with how they actually run communities.</p><p style="margin-top:18px"><a href="/locations">Browse all states →</a> · <a href="/solutions/community-association-management-software">Community association management software →</a></p></div></section>
<section class="section section--dark"><div class="container"><h2 class="section__headline" style="color:white">See Camvella with one of your {name} communities.</h2><a class="btn btn--primary btn--lg" href="/demo">Book a Demo</a></div></section>
</BaseLayout>
<style>.hero{padding:128px 0 74px;background:linear-gradient(135deg,var(--clr-navy),#0f5965);color:#fff}.hero h1{font-size:clamp(2.4rem,5vw,4.4rem);line-height:1.03;max-width:18ch;margin:8px 0 18px}.hero p:not(.section__label){max-width:65ch;line-height:1.7;color:rgba(255,255,255,.78);font-size:1.08rem}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:30px}.grid article{padding:25px;border:1px solid var(--clr-border);border-radius:16px;background:#fff}.grid h3{color:var(--clr-navy);margin-bottom:8px}.grid p{color:var(--clr-text-soft);line-height:1.65}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>