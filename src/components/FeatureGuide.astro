---
interface Props {
  eyebrow: string
  title: string
  description: string
  intro: string
  features: { title: string; body: string }[]
  workflow: { step: string; title: string; body: string }[]
  related?: { href: string; label: string }[]
}
const { eyebrow, title, description, intro, features, workflow, related = [] } = Astro.props
---
<section class="fg-hero">
  <div class="container fg-hero__grid">
    <div>
      <p class="fg-eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{intro}</p>
      <div class="fg-actions"><a href="/demo" class="btn btn--primary btn--lg">Book a Demo</a><a href="/product" class="btn btn--ghost btn--lg fg-ghost">View Product</a></div>
    </div>
    <div class="fg-panel">
      <p>Built into the same Camvella workspace</p>
      <div><span>Tenant scoped</span><span>Role aware</span><span>Searchable history</span><span>Connected records</span></div>
    </div>
  </div>
</section>
<section class="section">
  <div class="container">
    <p class="section__label">Capabilities</p>
    <h2 class="section__headline">{description}</h2>
    <div class="fg-grid">{features.map((f,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{f.title}</h3><p>{f.body}</p></article>)}</div>
  </div>
</section>
<section class="section section--alt">
  <div class="container fg-workflow">
    <div><p class="section__label">How it fits</p><h2 class="section__headline">A workflow your team can follow from start to finish.</h2><p class="section__subhead">Camvella keeps the operational record, permissions, documents, communication history, and related community context together.</p></div>
    <div class="fg-steps">{workflow.map(w=><div><span>{w.step}</span><section><h3>{w.title}</h3><p>{w.body}</p></section></div>)}</div>
  </div>
</section>
{related.length > 0 && <section class="section"><div class="container"><p class="section__label">Related workflows</p><h2 class="section__headline">Keep moving through the platform.</h2><div class="fg-related">{related.map(r=><a href={r.href}>{r.label}<span>→</span></a>)}</div></div></section>}
<section class="section section--dark"><div class="container fg-cta"><div><p class="section__label">See it live</p><h2 class="section__headline">Use your own workflow in the demo.</h2><p class="section__subhead">Bring one community and the way your team handles this work today. We will walk through it in Camvella.</p></div><a href="/demo" class="btn btn--primary btn--lg">Book a Demo</a></div></section>
<style>
.fg-hero{padding:calc(64px + var(--space-16)) 0 var(--space-16);background:linear-gradient(135deg,var(--clr-navy),#0d3857);color:#fff}.fg-hero__grid{display:grid;grid-template-columns:1.15fr .85fr;gap:var(--space-16);align-items:center}.fg-eyebrow{font-size:var(--text-xs);font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#7ed6df;margin-bottom:var(--space-4)}.fg-hero h1{font-size:clamp(2.3rem,4.7vw,4rem);line-height:1.02;letter-spacing:-.04em;max-width:18ch;margin-bottom:var(--space-5)}.fg-hero>div>div>div>p,.fg-hero__grid>div:first-child>p:last-of-type{font-size:var(--text-lg);line-height:1.7;color:rgba(255,255,255,.76);max-width:58ch}.fg-actions{display:flex;gap:var(--space-3);flex-wrap:wrap;margin-top:var(--space-8)}.fg-ghost{color:#fff;border-color:rgba(255,255,255,.28)}.fg-panel{padding:var(--space-8);border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);border-radius:var(--radius-xl)}.fg-panel>p{font-weight:800;margin-bottom:var(--space-5)}.fg-panel>div{display:grid;grid-template-columns:1fr 1fr;gap:10px}.fg-panel span{padding:12px;border-radius:10px;background:rgba(255,255,255,.07);font-size:var(--text-sm);color:rgba(255,255,255,.8)}.fg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-4);margin-top:var(--space-10)}.fg-grid article{padding:var(--space-5);border:1px solid var(--clr-border);border-radius:var(--radius-lg);background:#fff}.fg-grid article>span{font-size:var(--text-xs);font-weight:900;color:var(--clr-teal)}.fg-grid h3,.fg-steps h3{font-size:var(--text-base);color:var(--clr-navy);margin:var(--space-3) 0 var(--space-2)}.fg-grid p,.fg-steps p{font-size:var(--text-sm);line-height:1.65;color:var(--clr-text-soft)}.fg-workflow{display:grid;grid-template-columns:.85fr 1.15fr;gap:var(--space-16)}.fg-steps{display:flex;flex-direction:column;gap:var(--space-3)}.fg-steps>div{display:flex;gap:var(--space-4);padding:var(--space-5);background:#fff;border:1px solid var(--clr-border);border-radius:var(--radius-lg)}.fg-steps>div>span{font-size:var(--text-sm);font-weight:900;color:var(--clr-teal)}.fg-steps section h3{margin-top:0}.fg-related{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-4);margin-top:var(--space-8)}.fg-related a{display:flex;justify-content:space-between;gap:var(--space-4);padding:var(--space-5);border:1px solid var(--clr-border);border-radius:var(--radius-lg);font-weight:700;color:var(--clr-navy)}.fg-related a:hover{border-color:var(--clr-teal)}.fg-cta{display:flex;align-items:center;justify-content:space-between;gap:var(--space-10)}.fg-cta .section__headline{color:#fff}@media(max-width:900px){.fg-hero__grid,.fg-workflow{grid-template-columns:1fr}.fg-grid,.fg-related{grid-template-columns:repeat(2,1fr)}.fg-cta{align-items:flex-start;flex-direction:column}}@media(max-width:640px){.fg-grid,.fg-related,.fg-panel>div{grid-template-columns:1fr}}
</style>