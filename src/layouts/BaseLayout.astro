---
export interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  schema?: object
  noIndex?: boolean
}

const {
  title,
  description,
  canonical,
  ogImage = '/screenshots/dashboard.svg',
  schema,
  noIndex = false,
} = Astro.props

const pageTitle = title.includes('Camvella')
  ? title
  : `${title} | Camvella`

const canonicalUrl = canonical
  ? new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site)
canonicalUrl.search = ''
canonicalUrl.hash = ''
const canonicalHref = canonicalUrl.toString()
const ogImageHref = new URL(ogImage, Astro.site).toString()

// Production analytics properties
const CAMVELLA_GA4_ID = 'G-H1ZPCP2EE9'
const CAMVELLA_CLARITY_ID = 'y62zna7yna'
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalHref} />
  <link rel="alternate" hreflang="en-US" href={canonicalHref} />
  <link rel="alternate" hreflang="x-default" href={canonicalHref} />
  <meta
    name="robots"
    content={noIndex
      ? 'noindex, nofollow'
      : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
  />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImageHref} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Camvella" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image:alt" content="Camvella HOA management software" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageHref} />
  <meta name="twitter:image:alt" content="Camvella HOA management software" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/brand/camvella-favicon.svg?v=2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/brand/camvella-favicon.svg?v=2" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#0F1B2D" />

  <!-- Organization Schema -->
  <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://camvella.com/#organization",
      "name": "Camvella",
      "alternateName": ["Camvella HOA Software", "Camvella Community Association Management Software"],
      "url": "https://camvella.com/",
      "description": "Camvella is HOA and community association management software for professional community association management companies and CAM teams.",
      "logo": {
        "@type": "ImageObject",
        "url": "https://camvella.com/brand/camvella-logo-stacked.svg"
      },
      "knowsAbout": [
        "HOA management software",
        "community association management software",
        "CAM software",
        "HOA accounting software",
        "association management",
        "resident portals",
        "board portals",
        "violation management"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "url": "https://camvella.com/demo"
      }
    })}
  </script>

  <!-- WebSite Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://camvella.com/#website",
    "name": "Camvella",
    "alternateName": "Camvella HOA Management Software",
    "url": "https://camvella.com/",
    "publisher": { "@id": "https://camvella.com/#organization" },
    "about": { "@id": "https://camvella.com/#organization" },
    "inLanguage": "en-US"
  })} />

  <!-- Page-specific schema -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <!-- GA4 + Clarity Analytics -->
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${CAMVELLA_GA4_ID}`}></script>
  <script is:inline set:html={`
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '${CAMVELLA_GA4_ID}', { anonymize_ip: true });
  `} />
  <script is:inline set:html={`
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, 'clarity', 'script', '${CAMVELLA_CLARITY_ID}');
  `} />

  <style is:global>
/* ─── Camvella Design System ─────────────────────────────────────────────────
   Brand: Professional HOA management for serious operators.
   Tone: Confident, direct, premium SaaS. Navy + Camvella green/teal.
   Typography: Inter variable (self-hosted), system fallback.
   ─────────────────────────────────────────────────────────────────────────── */

/* ─── Tokens ─────────────────────────────────────────────────────────────── */
:root {
  /* ─── Camvella Brand Palette (derived from logo SVG) ───────────────────── */
  /* Logo green  #55B96A  — left loop                                         */
  /* Logo teal   #0B8F9C  — crossover                                         */
  /* Logo navy   #0B2748  — right loop + wordmark                             */

  /* Core brand */
  --clr-navy:        #0B2748;   /* logo navy — primary dark surface           */
  --clr-navy-mid:    #133256;   /* slightly lighter navy for cards/sections   */
  --clr-navy-soft:   #1B3D66;   /* hover/active navy states                  */

  /* Brand green — replaces amber as primary CTA / accent */
  --clr-amber:       #55B96A;   /* logo green — primary CTA, highlights      */
  --clr-amber-light: #7ECF90;   /* lighter green for dark-bg labels           */
  --clr-amber-dark:  #3D9B52;   /* darker green for hover states             */

  /* Brand teal — secondary accent */
  --clr-teal:        #0B8F9C;   /* logo teal — secondary accents, links      */
  --clr-teal-light:  #0FAFBF;   /* lighter teal                              */

  /* Semantic (unchanged) */
  --clr-success:     #22C55E;   /* success states — distinct from brand green */
  --clr-danger:      #EF4444;   /* errors / destructive                       */
  --clr-warning:     #F59E0B;   /* amber retained ONLY for warning states     */
  --clr-surface:     #FAFAFA;
  --clr-white:       #FFFFFF;
  --clr-text:        #111827;
  --clr-text-mid:    #374151;
  --clr-text-soft:   #6B7280;
  --clr-border:      #E5E7EB;
  --clr-border-soft: #F3F4F6;

  /* Typography */
  --font-display: 'Inter', system-ui, -apple-system, sans-serif;
  --font-body:    'Inter', system-ui, -apple-system, sans-serif;
  --font-mono:    'JetBrains Mono', 'Fira Code', monospace;

  /* Scale */
  --text-xs:   0.75rem;
  --text-sm:   0.875rem;
  --text-base: 1rem;
  --text-lg:   1.125rem;
  --text-xl:   1.25rem;
  --text-2xl:  1.5rem;
  --text-3xl:  1.875rem;
  --text-4xl:  2.25rem;
  --text-5xl:  3rem;
  --text-6xl:  3.75rem;
  --text-7xl:  4.5rem;

  /* Spacing */
  --space-1:  0.25rem;
  --space-2:  0.5rem;
  --space-3:  0.75rem;
  --space-4:  1rem;
  --space-5:  1.25rem;
  --space-6:  1.5rem;
  --space-8:  2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;
  --space-16: 4rem;
  --space-20: 5rem;
  --space-24: 6rem;
  --space-32: 8rem;

  /* Layout */
  --max-w-prose:  65ch;
  --max-w-site:   1200px;
  --max-w-narrow: 800px;

  /* Shadows */
  --shadow-sm:  0 1px 3px 0 rgb(0 0 0 / 0.1);
  --shadow-md:  0 4px 12px -1px rgb(0 0 0 / 0.12);
  --shadow-lg:  0 20px 40px -4px rgb(0 0 0 / 0.16);

  /* Radius */
  --radius-sm:  4px;
  --radius-md:  8px;
  --radius-lg:  12px;
  --radius-xl:  16px;
  --radius-full: 9999px;

  /* Transitions */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --dur-fast: 150ms;
  --dur-base: 250ms;
  --dur-slow: 400ms;
}

/* ─── Reset ─────────────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  font-size: 16px;
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: 1.6;
  color: var(--clr-text);
  background: var(--clr-white);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

img, svg { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button { cursor: pointer; font-family: inherit; border: none; background: none; }
input, textarea, select { font-family: inherit; font-size: inherit; }
ul, ol { list-style: none; }
h1, h2, h3, h4, h5, h6 { line-height: 1.2; font-weight: 700; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ─── Layout ─────────────────────────────────────────────────────────────── */
.container {
  width: 100%;
  max-width: var(--max-w-site);
  margin: 0 auto;
  padding: 0 var(--space-6);
}
@media (max-width: 640px) {
  .container { padding: 0 var(--space-4); }
}

.container--narrow {
  max-width: var(--max-w-narrow);
}

/* ─── Navigation ─────────────────────────────────────────────────────────── */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: 64px;
  display: flex;
  align-items: center;
  background: transparent;
  border-bottom: 1px solid transparent;
  transition: background var(--dur-base) var(--ease-out),
              border-color var(--dur-base) var(--ease-out);
}
.nav.is-scrolled {
  background: rgba(255 255 255 / 0.95);
  border-color: var(--clr-border);
  backdrop-filter: blur(8px);
}
.nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.nav__logo {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-weight: 800;
  font-size: var(--text-xl);
  letter-spacing: -0.03em;
  color: var(--clr-navy);
}
.nav__logo-mark {
  width: 32px;
  height: 32px;
  background: var(--clr-navy);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav__logo-mark svg { width: 20px; height: 20px; color: var(--clr-amber); }
.nav__links {
  display: flex;
  align-items: center;
  gap: var(--space-8);
}
.nav__link {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--clr-text-mid);
  transition: color var(--dur-fast);
}
.nav__link:hover { color: var(--clr-navy); }
.nav__actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.nav__mobile-toggle { display: none; }
@media (max-width: 768px) {
  .nav__links { display: none; }
  .nav__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--clr-navy);
  }
}

/* ─── Buttons ────────────────────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: 0.625rem 1.25rem;
  font-size: var(--text-sm);
  font-weight: 600;
  border-radius: var(--radius-md);
  transition: all var(--dur-fast) var(--ease-out);
  white-space: nowrap;
  line-height: 1;
  min-height: 44px;
}
.btn--primary {
  background: var(--clr-amber);
  color: var(--clr-navy);
}
.btn--primary:hover {
  background: var(--clr-amber-dark);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgb(85 185 106 / 0.35);
}
.btn--primary:active { transform: translateY(0); }

.btn--dark {
  background: var(--clr-navy);
  color: var(--clr-white);
}
.btn--dark:hover {
  background: var(--clr-navy-mid);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.btn--ghost {
  background: transparent;
  color: var(--clr-text-mid);
  border: 1px solid var(--clr-border);
}
.btn--ghost:hover {
  background: var(--clr-surface);
  color: var(--clr-text);
}

.btn--lg {
  padding: 0.875rem 1.75rem;
  font-size: var(--text-base);
  min-height: 52px;
}

.btn--sm {
  padding: 0.4rem 0.875rem;
  font-size: var(--text-xs);
  min-height: 36px;
}

/* ─── Hero ───────────────────────────────────────────────────────────────── */
.hero {
  padding-top: calc(64px + var(--space-20));
  padding-bottom: var(--space-20);
  background: var(--clr-navy);
  color: var(--clr-white);
  overflow: hidden;
  position: relative;
}
.hero::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 70% 50%, rgba(245 158 11 / 0.08) 0%, transparent 60%);
  pointer-events: none;
}
.hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-1) var(--space-3);
  background: rgba(245 158 11 / 0.15);
  border: 1px solid rgba(245 158 11 / 0.25);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--clr-amber-light);
  margin-bottom: var(--space-6);
}
.hero__headline {
  font-size: clamp(2.75rem, 4.6vw, 4.35rem);
  font-weight: 800;
  letter-spacing: -0.035em;
  line-height: 1.02;
  max-width: 15ch;
  margin-bottom: var(--space-6);
  text-wrap: balance;
}
.hero__headline em {
  font-style: normal;
  color: var(--clr-amber);
}
.hero__body {
  font-size: var(--text-lg);
  color: rgba(255 255 255 / 0.75);
  max-width: 52ch;
  margin-bottom: var(--space-10);
  line-height: 1.65;
}
.hero__actions {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}
.hero__trust {
  margin-top: var(--space-16);
  padding-top: var(--space-8);
  border-top: 1px solid rgba(255 255 255 / 0.1);
  display: flex;
  align-items: center;
  gap: var(--space-8);
  font-size: var(--text-sm);
  color: rgba(255 255 255 / 0.5);
  flex-wrap: wrap;
}
.hero__trust-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
.hero__trust-item svg { width: 16px; height: 16px; color: var(--clr-amber); }

/* ─── Screenshot Frame ───────────────────────────────────────────────────── */
.screen-frame {
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 32px 64px -16px rgb(0 0 0 / 0.4),
              0 0 0 1px rgba(255 255 255 / 0.08);
  background: var(--clr-navy-soft);
  aspect-ratio: 16 / 10;
  display: flex;
  align-items: flex-start;
  flex-direction: column;
}
.screen-frame__bar {
  width: 100%;
  height: 32px;
  background: rgba(255 255 255 / 0.05);
  border-bottom: 1px solid rgba(255 255 255 / 0.06);
  display: flex;
  align-items: center;
  padding: 0 var(--space-3);
  gap: var(--space-2);
  flex-shrink: 0;
}
.screen-frame__dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}
.screen-frame__dot:nth-child(1) { background: #FF5F57; }
.screen-frame__dot:nth-child(2) { background: #0B8F9C; }
.screen-frame__dot:nth-child(3) { background: #28C840; }
.screen-frame__content {
  flex: 1;
  width: 100%;
  background: #1A2440;
  padding: var(--space-4);
}

/* ─── Sections ───────────────────────────────────────────────────────────── */
.section {
  padding: var(--space-24) 0;
}
.section--alt {
  background: var(--clr-surface);
}
.section--dark {
  background: var(--clr-navy);
  color: var(--clr-white);
}

.section__label {
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--clr-amber-dark);
  margin-bottom: var(--space-3);
}
.section--dark .section__label { color: var(--clr-amber-light); }

.section__headline {
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  font-weight: 800;
  letter-spacing: -0.025em;
  margin-bottom: var(--space-4);
}
.section__subhead {
  font-size: var(--text-lg);
  color: var(--clr-text-soft);
  max-width: 56ch;
  line-height: 1.65;
}
.section--dark .section__subhead { color: rgba(255 255 255 / 0.65); }

/* ─── Feature Grid ───────────────────────────────────────────────────────── */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-6);
  margin-top: var(--space-12);
}
.feature-card {
  padding: var(--space-6);
  background: var(--clr-white);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  transition: box-shadow var(--dur-base) var(--ease-out),
              transform var(--dur-base) var(--ease-out);
}
.feature-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.feature-card__icon {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  background: rgba(15 27 45 / 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-4);
  color: var(--clr-navy);
}
.feature-card__title {
  font-size: var(--text-base);
  font-weight: 700;
  margin-bottom: var(--space-2);
  color: var(--clr-navy);
}
.feature-card__body {
  font-size: var(--text-sm);
  color: var(--clr-text-soft);
  line-height: 1.6;
}

/* ─── Capability Strip ───────────────────────────────────────────────────── */
.cap-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--clr-border);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-top: var(--space-12);
}
@media (max-width: 768px) {
  .cap-strip { grid-template-columns: 1fr; }
}
.cap-item {
  background: var(--clr-white);
  padding: var(--space-6);
}
.cap-item__num {
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--clr-amber-dark);
  margin-bottom: var(--space-2);
}
.cap-item__title {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--clr-navy);
  margin-bottom: var(--space-2);
}
.cap-item__body {
  font-size: var(--text-sm);
  color: var(--clr-text-soft);
  line-height: 1.55;
}

/* ─── Comparison Table ───────────────────────────────────────────────────── */
.comp-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: var(--space-10);
}
.comp-table th {
  padding: var(--space-4) var(--space-4) var(--space-3);
  font-size: var(--text-sm);
  font-weight: 700;
  text-align: left;
  border-bottom: 2px solid var(--clr-border);
}
.comp-table th.is-camvella {
  color: var(--clr-navy);
  background: rgba(245 158 11 / 0.06);
  border-bottom-color: var(--clr-amber);
}
.comp-table td {
  padding: var(--space-3) var(--space-4);
  font-size: var(--text-sm);
  border-bottom: 1px solid var(--clr-border-soft);
  color: var(--clr-text-mid);
  vertical-align: top;
}
.comp-table td.is-camvella {
  background: rgba(245 158 11 / 0.04);
  font-weight: 600;
  color: var(--clr-navy);
}
.comp-check { color: var(--clr-success); font-weight: 700; }
.comp-x { color: var(--clr-text-soft); }

/* ─── Quote / Callout ────────────────────────────────────────────────────── */
.callout {
  background: var(--clr-navy);
  color: var(--clr-white);
  border-radius: var(--radius-xl);
  padding: var(--space-10) var(--space-12);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-12);
  align-items: center;
}
@media (max-width: 768px) {
  .callout { grid-template-columns: 1fr; padding: var(--space-8) var(--space-6); }
}
.callout__headline {
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  font-weight: 800;
  letter-spacing: -0.025em;
  line-height: 1.2;
  margin-bottom: var(--space-4);
}
.callout__headline em { color: var(--clr-amber); font-style: normal; }
.callout__body {
  color: rgba(255 255 255 / 0.7);
  font-size: var(--text-base);
  line-height: 1.65;
  margin-bottom: var(--space-6);
}

/* ─── Pricing Card ───────────────────────────────────────────────────────── */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--space-6);
  margin-top: var(--space-12);
  align-items: start;
}
.pricing-card {
  background: var(--clr-white);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
}
.pricing-card.is-featured {
  border-color: var(--clr-navy);
  box-shadow: 0 0 0 2px var(--clr-navy);
}
.pricing-card__badge {
  display: inline-block;
  padding: var(--space-1) var(--space-3);
  background: var(--clr-amber);
  color: var(--clr-navy);
  font-size: var(--text-xs);
  font-weight: 700;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-4);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.pricing-card__name {
  font-size: var(--text-xl);
  font-weight: 800;
  color: var(--clr-navy);
  margin-bottom: var(--space-2);
}
.pricing-card__price {
  font-size: var(--text-4xl);
  font-weight: 800;
  color: var(--clr-navy);
  letter-spacing: -0.04em;
  line-height: 1;
  margin-bottom: var(--space-2);
}
.pricing-card__price sup {
  font-size: var(--text-xl);
  vertical-align: top;
  margin-top: 0.3em;
}
.pricing-card__period {
  font-size: var(--text-sm);
  color: var(--clr-text-soft);
  margin-bottom: var(--space-6);
}
.pricing-card__features {
  margin-bottom: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.pricing-feature {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  font-size: var(--text-sm);
  color: var(--clr-text-mid);
}
.pricing-feature svg { width: 16px; height: 16px; color: var(--clr-success); flex-shrink: 0; margin-top: 2px; }

/* ─── FAQ ────────────────────────────────────────────────────────────────── */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-top: var(--space-10);
}
.faq-item {
  border-bottom: 1px solid var(--clr-border);
}
.faq-item:last-child { border-bottom: none; }
.faq-q {
  width: 100%;
  text-align: left;
  padding: var(--space-5) var(--space-6);
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--clr-navy);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  background: var(--clr-white);
  transition: background var(--dur-fast);
}
.faq-q:hover { background: var(--clr-surface); }
.faq-q svg { width: 20px; height: 20px; color: var(--clr-text-soft); flex-shrink: 0; transition: transform var(--dur-base); }
.faq-q[aria-expanded="true"] svg { transform: rotate(180deg); }
.faq-a {
  padding: 0 var(--space-6) var(--space-5);
  font-size: var(--text-sm);
  color: var(--clr-text-mid);
  line-height: 1.65;
  background: var(--clr-white);
  display: none;
}
.faq-a.is-open { display: block; }

/* ─── Form ───────────────────────────────────────────────────────────────── */
.form-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}
.form-label {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--clr-navy);
}
.form-label span { color: var(--clr-danger); margin-left: 2px; }
.form-input, .form-select, .form-textarea {
  width: 100%;
  padding: 0.625rem 0.875rem;
  border: 1.5px solid var(--clr-border);
  border-radius: var(--radius-md);
  font-size: var(--text-base);
  color: var(--clr-text);
  background: var(--clr-white);
  transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  min-height: 44px;
}
.form-input:focus, .form-select:focus, .form-textarea:focus {
  outline: none;
  border-color: var(--clr-navy);
  box-shadow: 0 0 0 3px rgba(15 27 45 / 0.1);
}
.form-textarea { resize: vertical; min-height: 120px; }
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
}
@media (max-width: 640px) { .form-row { grid-template-columns: 1fr; } }

/* ─── Footer ─────────────────────────────────────────────────────────────── */
.footer {
  background: var(--clr-navy);
  color: rgba(255 255 255 / 0.7);
  padding: var(--space-16) 0 var(--space-8);
}
.footer__grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: var(--space-8);
  margin-bottom: var(--space-12);
}
@media (max-width: 768px) {
  .footer__grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 480px) {
  .footer__grid { grid-template-columns: 1fr; }
}
.footer__brand {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-weight: 800;
  font-size: var(--text-lg);
  color: var(--clr-white);
  margin-bottom: var(--space-3);
}
.footer__tagline {
  font-size: var(--text-sm);
  color: rgba(255 255 255 / 0.5);
  line-height: 1.55;
  max-width: 30ch;
}
.footer__col-title {
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255 255 255 / 0.4);
  margin-bottom: var(--space-4);
}
.footer__links {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.footer__link {
  font-size: var(--text-sm);
  color: rgba(255 255 255 / 0.65);
  transition: color var(--dur-fast);
}
.footer__link:hover { color: var(--clr-white); }
.footer__bottom {
  border-top: 1px solid rgba(255 255 255 / 0.1);
  padding-top: var(--space-6);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--text-xs);
  color: rgba(255 255 255 / 0.35);
  gap: var(--space-4);
  flex-wrap: wrap;
}

/* ─── Utilities ──────────────────────────────────────────────────────────── */
.text-center { text-align: center; }
.text-sm { font-size: var(--text-sm); }
.text-xs { font-size: var(--text-xs); }
.text-soft { color: var(--clr-text-soft); }
.text-amber { color: var(--clr-amber); }
.text-white { color: var(--clr-white); }
.font-bold { font-weight: 700; }
.mt-2 { margin-top: var(--space-2); }
.mt-4 { margin-top: var(--space-4); }
.mt-6 { margin-top: var(--space-6); }
.mt-8 { margin-top: var(--space-8); }
.mt-12 { margin-top: var(--space-12); }
.mb-4 { margin-bottom: var(--space-4); }
.mb-6 { margin-bottom: var(--space-6); }
.mb-8 { margin-bottom: var(--space-8); }

.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0,0,0,0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

/* ─── Logo image ─────────────────────────────────────────────────────────── */
.nav__logo { padding: 0; }
.nav__logo-img {
  height: 34px;
  width: auto;
  display: block;
  /* On dark hero pages the horizontal logo is navy — use the light version in footer */
}
/* Ensure nav has white bg always (not just on scroll) for readability */
.nav {
  background: rgba(255 255 255 / 0.97);
  border-bottom: 1px solid var(--clr-border);
  backdrop-filter: blur(8px);
}
/* Override the transparent default — nav should always be white */
.nav.is-scrolled {
  background: rgba(255 255 255 / 0.99);
}

/* ─── Brand teal — secondary accent ─────────────────────────────────────── */
a:not(.btn):hover { color: var(--clr-teal); }
.text-teal { color: var(--clr-teal); }

/* ─── Mobile navigation ────────────────────────────────────────────────── */
.nav__mobile-menu {
  position: absolute;
  top: 64px;
  left: 0;
  right: 0;
  padding: var(--space-4);
  background: rgba(11 39 72 / 0.99);
  border-bottom: 1px solid rgba(255 255 255 / 0.12);
  box-shadow: 0 14px 28px rgba(0 0 0 / 0.22);
  z-index: 1000;
}
.nav__mobile-menu[hidden] { display: none !important; }
.nav__mobile-menu a:not(.btn) {
  display: block;
  padding: .8rem .5rem;
  color: rgba(255 255 255 / .9);
  font-weight: 600;
}
.nav__mobile-menu .btn { width: 100%; margin-top: var(--space-3); }
@media (min-width: 769px) { .nav__mobile-menu { display: none !important; } }

/* ─── Hero Module Grid (replaces empty screenshot frame) ───────────────── */
.hero-modules {
  border-top: 1px solid rgba(255 255 255 / 0.1);
  padding-top: var(--space-8);
}
.hero-module-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}
@media (max-width: 640px) {
  .hero-module-grid { grid-template-columns: 1fr 1fr; }
}
.hero-module-card {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-4);
  background: rgba(255 255 255 / 0.05);
  border: 1px solid rgba(255 255 255 / 0.08);
  border-radius: var(--radius-lg);
  transition: background var(--dur-fast);
}
.hero-module-card:hover {
  background: rgba(85 185 106 / 0.08);
  border-color: rgba(85 185 106 / 0.2);
}
.hero-module-icon {
  font-size: 1.25rem;
  flex-shrink: 0;
  margin-top: 1px;
}
.hero-module-label {
  font-size: var(--text-sm);
  font-weight: 700;
  color: rgba(255 255 255 / 0.9);
  margin-bottom: 2px;
}
.hero-module-sub {
  font-size: var(--text-xs);
  color: rgba(255 255 255 / 0.45);
  line-height: 1.4;
}

/* ─── Nav on dark hero — use light logo variant ─────────────────────────── */
/* The nav is transparent on dark hero, opaque on scroll */
.nav {
  background: rgba(11 39 72 / 0.85) !important;
  border-bottom: 1px solid rgba(255 255 255 / 0.08) !important;
  backdrop-filter: blur(12px);
}
.nav.is-scrolled {
  background: rgba(11 39 72 / 0.97) !important;
  border-bottom-color: rgba(255 255 255 / 0.1) !important;
}
.nav__link { color: rgba(255 255 255 / 0.75) !important; }
.nav__link:hover { color: var(--clr-amber) !important; } /* brand green on hover */
.nav__logo-img { filter: none; } /* dark-nav variant has correct colors built in */

/* Sign In button on dark nav */
.nav__actions .btn--ghost {
  color: rgba(255 255 255 / 0.85) !important;
  border-color: rgba(255 255 255 / 0.2) !important;
}
.nav__actions .btn--ghost:hover {
  background: rgba(255 255 255 / 0.08) !important;
}

/* ─── Hero two-column layout ─────────────────────────────────────────────── */
.hero__two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: center;
}
.hero__left { min-width: 0; }
.hero__right { min-width: 0; }

@media (max-width: 900px) {
  .hero__two-col {
    grid-template-columns: 1fr;
  }
  .hero__left {
    max-width: 760px;
  }
  .hero__headline {
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    max-width: 17ch;
  }
  .hero__right { display: none; }
}
@media (max-width: 640px) {
  .hero {
    padding-top: calc(64px + var(--space-10));
    padding-bottom: var(--space-12);
  }
  .hero__eyebrow {
    margin-bottom: var(--space-4);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
  }
  .hero__headline {
    max-width: 15ch;
    font-size: clamp(2rem, 7vw, 2.65rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-4);
    text-wrap: balance;
  }
  .hero__body {
    max-width: 36rem;
    font-size: 0.98rem;
    line-height: 1.5;
    margin-bottom: var(--space-6);
  }
  .hero__actions {
    gap: var(--space-3);
  }
  .hero__actions .btn {
    flex: 1 1 100%;
    justify-content: center;
  }
  .hero-modules {
    margin-top: var(--space-4);
  }
}

/* ─── Hero visual frame (right column) ───────────────────────────────────── */
.hero__visual-frame {
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid rgba(255 255 255 / 0.1);
  background: rgba(11 39 72 / 0.6);
  backdrop-filter: blur(8px);
  box-shadow: 0 32px 64px -16px rgba(0 0 0 / 0.5),
              inset 0 1px 0 rgba(255 255 255 / 0.05);
}
.hero__visual-bar {
  height: 36px;
  background: rgba(255 255 255 / 0.04);
  border-bottom: 1px solid rgba(255 255 255 / 0.06);
  display: flex;
  align-items: center;
  padding: 0 var(--space-3);
  gap: var(--space-2);
}
.hero__visual-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255 255 255 / 0.12);
}
.hero__visual-dot:nth-child(1) { background: rgba(85 185 106 / 0.4); }
.hero__visual-dot:nth-child(2) { background: rgba(11 143 156 / 0.4); }
.hero__visual-dot:nth-child(3) { background: rgba(255 255 255 / 0.12); }
.hero__visual-url {
  flex: 1;
  text-align: center;
  font-size: 0.7rem;
  color: rgba(255 255 255 / 0.25);
  letter-spacing: 0.04em;
  margin-right: 48px; /* offset for the dots */
}
.hero__visual-content {
  min-height: 320px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-8);
  text-align: center;
  gap: var(--space-4);
}
.hero__visual-label {
  font-size: var(--text-sm);
  font-weight: 600;
  color: rgba(255 255 255 / 0.3);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.hero__visual-sub {
  font-size: var(--text-xs);
  color: rgba(255 255 255 / 0.15);
}

/* ─── CTA contrast verification ──────────────────────────────────────────── */
/* btn--primary: #55B96A bg, white text                                       */
/* Contrast: white (#fff) on #55B96A = 3.04:1 — borderline AA for large text  */
/* Fix: darken to #3D9B52 for white text to achieve 4.5:1 AA compliance       */
.btn--primary {
  background: var(--clr-amber-dark);   /* #3D9B52 — AA compliant with white  */
  color: #ffffff;
}
.btn--primary:hover {
  background: #2D7A3F;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(61 155 82 / 0.4);
}
/* Focus state — teal ring for visibility */
.btn--primary:focus-visible {
  outline: 3px solid var(--clr-teal);
  outline-offset: 3px;
}
.btn--dark:focus-visible,
.btn--ghost:focus-visible {
  outline: 3px solid var(--clr-teal);
  outline-offset: 3px;
}

/* ─── Hero module cards on mobile ────────────────────────────────────────── */
@media (max-width: 390px) {
  .hero-module-grid { grid-template-columns: 1fr; }
  .hero-module-card { padding: var(--space-3); }
}

/* ─── Teal as secondary accent — links, hover, focus ─────────────────────── */
:root {
  --clr-teal: #0B8F9C;
  --clr-teal-light: #0FAFBF;
}
.section__label { color: var(--clr-teal); }
.section--dark .section__label { color: var(--clr-teal-light); }

/* Feature card accent line on hover */
.feature-card:hover {
  border-color: var(--clr-teal);
  box-shadow: 0 4px 12px rgba(11 143 156 / 0.1);
}

/* Table comparison header */
.comp-table th.is-camvella {
  border-bottom-color: var(--clr-amber); /* green — our column */
}

/* ─── Kill any injected top-bar (Cloudflare workers.dev preview badge) ──── */
/* This only appears on the workers.dev preview URL, not on production.        */
/* Belt-and-suspenders: if anything injects a colored top border, override it. */
html::before {
  display: none !important;
}
body > *:first-child[style*="background"][style*="position: fixed"][style*="top: 0"] {
  display: none !important;
}

