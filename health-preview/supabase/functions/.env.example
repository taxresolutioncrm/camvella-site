# Edge Function application/provider secrets only.
# Supabase injects SUPABASE_URL / publishable keys / secret keys automatically.
# Do not commit real values.

APP_ALLOWED_ORIGIN=https://YOUR_APP_DOMAIN

# Provider-specific secrets are added only when that provider is selected.
EMAIL_PROVIDER_API_KEY=
VOICE_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
FAX_PROVIDER_API_KEY=
MARKETPLACE_API_KEY=
CARRIER_WEBHOOK_SECRET=

PUBLIC_ENDPOINT_SALT=
PUBLIC_INTAKE_ENABLED=false
PUBLIC_BOOKING_ENABLED=false
